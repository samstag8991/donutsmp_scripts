  w_box(lx + 125, y, 75, "default_margin", menu["margin"], "3")
  y = y + 22
  w_label(lx, y, 120, "Selling speed")
  w_button(lx + 125, y, 75, speed_name(), "sellspeed")
  y = y + 24
  w_button(lx, y, 98, "Scan spreads", "scan")
  if trading:
    w_button(lx + 102, y, 98, "§aResume", "close")
  else:
    act = active_list()
    st = "§aStart (best of " + str(len(act)) + ")"
    if len(act) == 1:
      st = "§aTrade " + nice_name(act[0]["item"])
      if len(st) > 20:
        st = clip(st, 0, 20)
    w_button(lx + 102, y, 98, st, "start")
  y = y + 22
  if trading:
    w_button(lx, y, 200, "§cStop the script", "stop")
  left_end = y
  f = menu["f"]
  y = top + 22
  head = "§fNew item"
  if menu["sel"] >= 0 and menu["sel"] < len(SELL):
    head = "§fEditing: " + nice_name(SELL[menu["sel"]]["item"])
  w_label(rx, y, fw - 30, head)
