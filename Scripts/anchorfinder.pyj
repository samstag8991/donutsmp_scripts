  y = y + 20
  for ln in menu["lines"]:
    w_label(x, y, 320, ln)
    y = y + 14
  y = y + 10
  w_button(x, y, 100, "§aOrder", "yes")
  w_button(x + 110, y, 100, "§cSkip", "no")
  w_button(x + 220, y, 100, "Order + AUTO", "auto")

def menu_do(a):
  global MM_MODE, PICK_BY, trading, SELL_SPEED_PCT
  f = dget(menu, "f", None)
  if a == "none":
    return
  if a.startswith("sel:"):
    i = to_int(parse_money(clip(a, 4, len(a))))
    if i < len(SELL):
      menu["sel"] = i
      menu["f"] = fields_of(SELL[i])
      menu["msg"] = ""
  elif a.startswith("tog:"):
    i = to_int(parse_money(clip(a, 4, len(a))))
    if i < len(SELL):
      SELL[i]["on"] = not is_on(SELL[i])
      save_list()
      if is_on(SELL[i]):
        menu["msg"] = "§a" + nice_name(SELL[i]["item"]) + " will be traded"
      else:
        menu["msg"] = "§7" + nice_name(SELL[i]["item"]) + " switched off (kept on the list)"
  elif a.startswith("del:"):
    i = to_int(parse_money(clip(a, 4, len(a))))
    if i < len(SELL):
      if mm_round is not None and mm_round["item"] == SELL[i]["item"]:
        menu["msg"] = "§cit's in a round right now - can't remove"
      else:
        nm = label_of(SELL[i])
        keep = []
        for k in range(len(SELL)):
          if k != i:
            keep.append(SELL[k])
        set_sell(keep)
        save_list()
        forget_scan()
        menu["sel"] = -1
        menu["f"] = blank_fields()
        menu["msg"] = "§7removed " + nm
  elif a == "trash":
    if menu["sel"] >= 0 and menu["sel"] < len(SELL):
      menu_do("del:" + str(menu["sel"]))
    else:
      menu["f"] = blank_fields()
      menu["msg"] = ""
  elif a == "adv":
    menu["adv"] = not dget(menu, "adv", False)
  elif a == "per":
    k = 0
    while k < len(PER_STEPS) and PER_STEPS[k] != f["per"]:
      k = k + 1
    f["per"] = PER_STEPS[(k + 1) % len(PER_STEPS)]
  elif a == "save":
    save_item()
  elif a == "mode":
    if MM_MODE == "auto":
      MM_MODE = "ask"
    else:
      MM_MODE = "auto"
    save_list()
  elif a == "sellspeed":
    if SELL_SPEED_PCT >= 100:
      SELL_SPEED_PCT = 80
    else:
      SELL_SPEED_PCT = 100
    save_list()
  elif a == "pick":
    if PICK_BY == "profit":
      PICK_BY = "percent"
    else:
      PICK_BY = "profit"
    save_list()
  elif a == "scan":
    take_margin()
    if len(SELL) == 0:
      menu["msg"] = "§cadd an item first"
    else:
      close_menu()
      start_menu_scan()
      say("reading the spreads (buys nothing) - the menu comes back with the results")
      return
  elif a == "start":
    take_margin()
    if len(active_list()) == 0:
      menu["msg"] = "§cswitch an item on first (the ✔ on the left)"
    else:
      trading = True
      close_menu()
      show_list()
      names = []
      for x in active_list():
        names.append(nice_name(x["item"]))
      say("trading only: " + ", ".join(names))
      say("starting in " + MM_MODE.upper() + " mode - it reads the spreads first and only buys when it's worth it")
      return
  elif a == "close":
    take_margin()
    close_menu()
    if not trading:
      shutdown("MM: closed without starting.")
    return
  elif a == "stop":
    close_menu()
    shutdown("MM stopped from the menu.")
    return
  elif a == "yes" or a == "no" or a == "auto":
    c = menu["cfg"]
    close_menu()
    if a == "auto":
      MM_MODE = "auto"
      save_list()
      say("AUTO on: starts rounds by itself while the spread is good")
    mm_confirmed(c, a != "no")
    return
  menu["dirty"] = True

def start_menu_scan():
  global mm_cands, mm_cands_t, mm_scan_survey
  mm_cands = []
  mm_cands_t = -1
  mm_scan_survey = True
  mm_queue_scans([])

def forget_scan():
  global mm_cands_t
  mm_cands_t = -1

def take_margin():
  global MIN_PROFIT_PCT
  v = untok(menu["margin"])
  if v is not None and v >= 0 and v != MIN_PROFIT_PCT:
    MIN_PROFIT_PCT = v
    save_list()

def save_item():
  global last_check
  f = menu["f"]
  txt = f["item"].strip().lower()
  if txt == "":
    menu["msg"] = "§ctype an item name"
    return
  item = item_arg(txt.replace(" ", "_"))
  amount = 64
  if f["amount"].strip() != "":
    amount = untok(f["amount"])
  if amount is None or amount < 1:
    menu["msg"] = "§cbuy amount must be a number like 64"
    return
  margin = None
  if f["margin"].strip() != "":
    margin = untok(f["margin"])
    if margin is None or margin < 0:
      menu["msg"] = "§cmin profit must be a % like 5"
      return
  price = "auto"
  if f["price"].strip() != "" and f["price"].strip().lower() != "auto":
    price = untok(f["price"])
    if price is None or price <= 0:
      menu["msg"] = "§csell price: auto or a price like 59k"
      return
  maxbuy = None
  if f["maxbuy"].strip() != "":
    maxbuy = untok(f["maxbuy"])
    if maxbuy is None or maxbuy <= 0:
      menu["msg"] = "§cmax bid: a price like 45k, or empty"
      return
  if mm_round is not None and mm_round["item"] == item:
    menu["msg"] = "§cit's in a round right now - change it after the round"
    return
  lab = f["label"]
  if lab is not None and default_label(item) == lab:
    lab = None
  old = cfg_of(item)
  if old is not None and lab is None and f["label"] is None:
    lab = old["label"]
  c = {"item": item, "total": amount, "per_listing": to_int(f["per"]), "price": price, "min": None, "max": None,
       "margin": margin, "maxbuy": maxbuy, "label": lab}
  if old is not None:
    c["min"] = old["min"]
    c["max"] = old["max"]
    c["on"] = is_on(old)
  keep = []
  idx = -1
  for x in SELL:
    if x["item"] == item:
      idx = len(keep)
      keep.append(c)
    else:
      keep.append(x)
  if idx < 0:
    idx = len(keep)
    keep.append(c)
  set_sell(keep)
  save_list()
  forget_scan()
  last_check = -1
  menu["sel"] = idx
  menu["f"] = fields_of(c)
  menu["msg"] = "§asaved " + label_of(c)
  say("saved " + describe(c))

def close_menu():
  global menu
  menu = None
  hide_gui(False)
  try:
    set_screen(None)
  except Exception:
    pass
  reset_btn_actions()

def reset_btn_actions():
  global btn_actions
  btn_actions = {}

def ask_confirm(c, text):
  global menu_request, menu
  lines = ["§f" + text]
  if mm_pending is not None:
    r = mm_pending
    lines.append("§7buyers pay " + fmt_money(r["top"]) + ", you'd bid " + fmt_money(r["bid"]) + ", auction sells at " + fmt_money(r["ask"]))
    lines.append("§7profit per item " + fmt_money(r["net"] - r["bid"]) + " = " + trim_num(r["pct"]) + "%, rough " + trim_num(r["rpct"]) + "%")
    lines.append("§7this round: about " + fmt_money(r["qty"] * (r["net"] - r["bid"])))
  menu = {"kind": "confirm", "lines": lines, "cfg": c, "pending": True}
  menu_request = "confirm"

def menu_open_now():
  global menu_request, menu, trading
  if menu_request is None:
    return False
  if len(steps) > 0 and dget(steps[0][1], "phase", 0) != 0:
    return False
  if typer is not None:
    return False
  kind = menu_request
  menu_request = None
  if not open_menu(kind):
    if kind == "confirm" and menu is not None:
      c = menu["cfg"]
      t = strip_codes(menu["lines"][0])
      menu = None
      ask_confirm_chat(c, t)
    elif not trading:
      trading = True
      if len(SELL) == 0:
        start_wizard(True)
    return False
  return True

def menu_tick():
  global menu
  if menu is None or "scr" not in menu:
    return False
  scr = get_screen()
  if scr is None or not same_obj(scr, menu["scr"]):
    if tick_count - menu["t0"] < 20:
      return True
    if menu["kind"] == "confirm":
      menu_do("no")
    else:
      menu_do("close")
    return True
  size = str(scr.width) + "x" + str(scr.height)
  if not menu["built"] or menu["dirty"] or dget(menu, "size", "") != size or len(widgets_of(scr)) == 0:
    menu["size"] = size
    try:
      build_menu()
    except Exception as e:
      say("the menu failed (" + short_error(e) + ") - use the chat commands (\\marketmaker help)")
      close_menu()
      return True
  read_boxes()
  while len(menu_actions) > 0 and menu is not None:
    a = menu_actions[0]
    del menu_actions[0]
    menu_do(a)
  return True

def key_tick():
  global key_was_down, menu_request
  down = False
  try:
    IC = JavaClass("com.mojang.blaze3d.platform.InputConstants")
    try:
      down = IC.isKeyDown(mc.getWindow(), MENU_KEY_CODE)
    except Exception:
      down = IC.isKeyDown(mc.getWindow().getWindow(), MENU_KEY_CODE)
  except Exception:
    return
  if down and not key_was_down and get_screen() is None and menu is None and menu_request is None:
    menu_request = "main"
    say("opening the menu (it waits until it's done with what it's doing)")
  key_was_down = down

def check_menu_request():
  global menu_request
  v = System.getProperty(MENU_KEY)
  if v is None or str(v) == "":
    return
  System.setProperty(MENU_KEY, "")
  if menu is None and menu_request is None:
    menu_request = "main"

def mm_note(item, txt):
  scan_note[item] = txt

ITEMS = {"mm": {"id": "?", "name": "?", "search": "?", "label": "?", "exclude": []}}
top_price = {"mm": None}
orders_info = []
orders_read_ok = False
order_slots_free = -1
done_orders = {}
more_to_collect = False
expect_orders = False
last_collect = -1
mm_peek_found = 0

ask_info = {}
mm_round = None
mm_next_scan = 0
mm_next_collect = 0
mm_last_rebid = 0
mm_collected = {}
mm_scan_queue = []
mm_scan_only = False
mm_session = 0.0
mm_rounds_done = 0
mm_noted = {}
mm_pending = None
mm_pending_cfg = None
mm_cands_t = -1
mm_scan_survey = False
mm_between = -1
mm_cands = []
mm_samples = {}
mm_all_up = False
mm_hist = {}
mm_rate = {}

def mm_price_seen(item, cheapest, normal):
  normal = cheapest
  if normal is None or normal <= 0:
    return None
  if item not in mm_hist:
    mm_hist[item] = []
  h = mm_hist[item]
  if len(h) > 0 and tick_count - h[len(h) - 1][0] < 400:
    h[len(h) - 1] = [h[len(h) - 1][0], normal * 1.0]
  else:
    h.append([tick_count, normal * 1.0])
  keep = []
  for e in h:
    if tick_count - e[0] <= VOL_WINDOW_MIN * 1200:
      keep.append(e)
  mm_hist[item] = keep
  return None

def typical_cheapest(item):
  if item not in mm_hist:
    return None
  h = mm_hist[item]
  if len(h) < 3 or h[len(h) - 1][0] - h[0][0] < 1200:
    return None
  vals = []
  for e in h:
    vals.append(e[1])
  return median(vals)

def vol_pct(item):
  if item not in mm_hist:
    return None
  h = mm_hist[item]
  if len(h) < 3 or h[len(h) - 1][0] - h[0][0] < 400:
    return None
  s = 0.0
  for e in h:
    s = s + e[1]
  avg = s / len(h)
  if avg <= 0:
    return None
  q = 0.0
  for e in h:
    q = q + (e[1] - avg) * (e[1] - avg)
  return JMath.sqrt(q / len(h)) / avg * 100.0

def need_margin(c):
  base = margin_of(c)
  v = vol_pct(c["item"])
  if v is None or VOL_K <= 0:
    return [base, None]
  return [base + VOL_K * v, v]

def mm_cap_qty(c, qty):
  item = c["item"]
  if SELL_HOURS <= 0 or item not in mm_rate or mm_rate[item] is None:
    return [qty, None]
  cap = to_int(mm_rate[item] * SELL_HOURS)
  if cap < MIN_ROUND_QTY:
    cap = to_int(MIN_ROUND_QTY)
  if qty > cap:
    qty = cap
  return [qty, mm_rate[item]]

def round_rate(r):
  if r is None or r["first_got"] < 0:
    return None
  n = get0(sold, r["item"]) - r["sold0"]
  t = tick_count - r["first_got"]
  if n <= 0 or t < 6000:
    return None
  return n / (t / 72000.0)

def mm_id():
  return ITEMS["mm"]["id"]

def set_item(c):
  lab = label_of(c)
  ITEMS["mm"] = {"id": c["item"], "name": lab, "search": c["item"].replace("_", " "), "label": lab, "exclude": []}
  top_price["mm"] = None

def find_item_btn(scr, key):
  want = words(ITEMS[key]["label"])
  wj = " ".join(want)
  best = None
  best_n = 999
  for w in widgets_of(scr):
    if not is_button(w):
      continue
    t = wtext(w)
    vis = t
    j = last_find(t, "]")
    if j >= 0:
      vis = clip(t, j + 1, len(t))
    vw = words(vis)
    if " ".join(vw) == wj:
      return w
    if not has_run(vw, want):
      continue
    if len(vw) < best_n:
      best_n = len(vw)
      best = w
  return best

def fail_stop(msg):
  shutdown("MM: " + msg + " - stopped so nothing goes wrong. Send me this line.")
  return True

def wants(item_id):
  return free_slots() > KEEP_FREE

def bid_price(key, top):
  return clean_price(outbid(top) + top * BID_EXTRA_PCT / 100.0)

def record_order(kind, amount, price, rebid):
  r = mm_round
  if r is None:
    return None
  if rebid:
    r["spent"] = r["spent"] - amount * r["order_price"]
  r["spent"] = r["spent"] + amount * price
  r["order_price"] = price * 1.0
  r["order_made"] = tick_count
  return None

def confirm_orders(infos):
  return None

def check_review(text, d):
  i = text.find("item:")
  if i < 0:
    return "can't read it: " + clip(text, 0, 90)
  ws = words(clip(text, i + 5, i + 60))
  want = words(ITEMS[d["key"]]["label"])
  k = 0
  while k < len(want):
    if k >= len(ws) or ws[k] != want[k]:
      return "item is not " + ITEMS[d["key"]]["name"]
    k = k + 1
  amount = value_after(text, "amount:")
  if amount is None or JMath.abs(amount - d["amount"]) > 0.5:
    return "amount is " + str(amount) + ", should be " + str(d["amount"])
  price = value_after(text, "price:")
  if not shown_ok(price, d["price"]):
    return "price is " + str(price) + ", should be " + fmt_price(d["price"])
  total = value_after(text, "total:")
  if total is not None:
    if total > MAX_ROUND_COST * 1.01:
      return "total $" + fmt_price(total) + " is over MAX_ROUND_COST"
    if not shown_ok(total, d["amount"] * d["price"]):
      return "total is $" + fmt_price(total) + ", should be $" + fmt_price(d["amount"] * d["price"])
  return None

def finish_read_top(d, key, name):
  best = d["best"]
  top_price[key] = best
  pages = d["page"]
  if timed_out(d, 60) and pages > 1:
    pages = pages - 1
  if best is None:
    say("no buy orders for " + name + " found (looked through " + str(pages) + " pages)")
  else:
    say("best buy order for " + name + ": " + fmt_money(best) + " each (page " + str(d["best_page"]) + ")")
  close_all()
  wait(hdelay(6, 12))
  return True

def mm_see_orders(infos):
  r = mm_round
  if r is None:
    return None
  mine = []
  for o in infos:
    if o["id"] == r["item"]:
      mine.append(o)
  r["seen"] = mine
  r["seen_tick"] = tick_count
  return None

def mm_got(got):
  r = mm_round
  if r is None:
    return None
  r["bought"] = r["bought"] + got
  if r["first_got"] < 0:
    r["first_got"] = tick_count
  mm_collected[r["item"]] = get0(mm_collected, r["item"]) + got
  global_check_now()
  return None

def mm_numbers(c, bid):
  item = c["item"]
  res = {"ok": False, "why": None, "top": top_price["mm"], "bid": bid, "ask": None, "net": None, "pct": None,
         "rbid": None, "rnet": None, "rpct": None, "n": 0, "dump": False, "qty": 0}
  info = None
  if item in ask_info:
    info = ask_info[item]
  if info is not None:
    res["n"] = info["n"]
    res["dump"] = info["dump"]
  askp = None
  if c["price"] != "auto":
    askp = c["price"] * 1.0
  elif info is not None and info["cheapest"] is not None:
    askp = info["cheapest"]
    if info["dump"] and info["normal"] is not None:
      askp = info["normal"]
  if askp is None:
    res["why"] = "no auction price to sell at (nobody else lists it - set a fixed price: \\marketmaker set " + item + " price 59k)"
    return res
  if c["max"] is not None and askp > c["max"]:
    askp = c["max"] * 1.0
  res["ask"] = askp
  net = ah_net(askp)
  res["net"] = net
  res["pct"] = (net - bid) / bid * 100.0
  res["rbid"] = bid * (1.0 + WAR_PCT / 100.0)
  res["rnet"] = net * (1.0 - AH_DROP_PCT / 100.0)
  res["rpct"] = (res["rnet"] - res["rbid"]) / res["rbid"] * 100.0
  nv = need_margin(c)
  need = nv[0]
  res["need"] = need
  res["vol"] = nv[1]
  if c["maxbuy"] is not None and bid > c["maxbuy"]:
    res["why"] = "you'd have to bid " + fmt_money(bid) + ", above your max bid " + fmt_money(c["maxbuy"])
  elif res["pct"] < need:
    res["why"] = "profit " + trim_num(res["pct"]) + "% is under the " + trim_num(need) + "% you want"
  elif ROUGH_ESTIMATE and res["rpct"] <= 0:
    res["why"] = "fine today but the rough estimate (bid +" + num_str(WAR_PCT) + "%, auction -" + num_str(AH_DROP_PCT) + "%) loses " + trim_num(-res["rpct"]) + "%"
  else:
    res["ok"] = True
  qty = to_int(c["total"])
  cq = mm_cap_qty(c, qty)
  res["rate"] = cq[1]
  res["capped"] = cq[0] < qty
  qty = cq[0]
  if bid > 0:
    if qty * bid > MAX_ROUND_COST:
      qty = to_int(MAX_ROUND_COST / bid)
    bal = read_balance()
    if bal is not None and qty * bid > bal * 0.98:
      qty = to_int(bal * 0.98 / bid)
  res["qty"] = qty
  if res["ok"] and qty < 1:
    res["ok"] = False
    res["why"] = "you can't afford even one at " + fmt_money(bid)
  return res

def mm_floor(item):
  r = mm_round
  if r is None or r["item"] != item or r["qty_total"] <= 0:
    return None
  if SELL_AT_LOSS_MIN > 0 and r["first_got"] >= 0 and tick_count - r["first_got"] > SELL_AT_LOSS_MIN * 1200:
    return None
  avg = r["spent"] / r["qty_total"]
  return JMath.ceil(avg / (1.0 - AH_FEE_PCT / 100.0))

def st_mm_begin(d):
  c = d["cfg"]
  set_item(c)
  ask_info[c["item"]] = None
  prices[c["item"]] = None
  say("reading the spread for " + label_of(c) + " ...")
  mm_samples[c["item"]] = []
  k = 1
  if not d["scan_only"] and mm_round is None and not dget(d, "survey", False):
    steps.insert(k, [st_collect, {"phase": 0, "peek": True}])
    k = k + 1
  passes = to_int(SCAN_PASSES)
  if passes < 1:
    passes = 1
  for p in range(passes):
    if p > 0:
      steps.insert(k, [st_mm_gap, {"phase": 0}])
      k = k + 1
    steps.insert(k, [st_read_top, {"phase": 0, "key": "mm"}])
    k = k + 1
    steps.insert(k, [st_recon, {"phase": 0, "cfg": c}])
    k = k + 1
    steps.insert(k, [st_mm_sample, {"phase": 0, "cfg": c, "pass": p + 1, "of": passes}])
    k = k + 1
  steps.insert(k, [st_mm_judge, {"phase": 0, "cfg": c, "scan_only": d["scan_only"], "survey": dget(d, "survey", False)}])
  return True

def st_mm_gap(d):
  if d["phase"] == 0:
    d["until"] = tick_count + to_int(SCAN_GAP_SEC * 20)
    d["phase"] = 1
    return False
  return tick_count >= d["until"]

def st_mm_sample(d):
  c = d["cfg"]
  item = c["item"]
  info = None
  if item in ask_info:
    info = ask_info[item]
  s = {"top": top_price["mm"], "ch": None, "nm": None, "n": 0}
  if info is not None:
    s["ch"] = info["cheapest"]
    s["nm"] = info["normal"]
    s["n"] = info["n"]
  if item not in mm_samples:
    mm_samples[item] = []
  mm_samples[item].append(s)
  if d["of"] > 1:
    t = "§7read " + str(d["pass"]) + "/" + str(d["of"]) + ": buyers pay "
    if s["top"] is None:
      t = t + "-"
    else:
      t = t + fmt_money(s["top"])
    t = t + ", auction cheapest "
    if s["ch"] is None:
      t = t + "-"
    else:
      t = t + fmt_money(s["ch"])
    say(t)
  return True

def lo_hi(vals):
  lo = None
  hi = None
  for v in vals:
    if lo is None or v < lo:
      lo = v
    if hi is None or v > hi:
      hi = v
  return [lo, hi]

def mm_merge_samples(item):
  if item not in mm_samples:
    return None
  ss = mm_samples[item]
  if len(ss) < 2:
    return None
  tops = []
  chs = []
  nms = []
  n = 0
  for s in ss:
    if s["top"] is not None:
      tops.append(s["top"])
    if s["ch"] is not None and s["nm"] is not None:
      chs.append(s["ch"])
      nms.append(s["nm"])
    if s["n"] > n:
      n = s["n"]
  if len(tops) == 0:
    top_price["mm"] = None
  else:
    top = median(tops)
    last = tops[len(tops) - 1]
    if last > top:
      top = last
    top_price["mm"] = top
  if len(chs) == 0:
    ask_info[item] = None
    return None
  ch = median(chs)
  nm = median(nms)
  lh = lo_hi(chs)
  rest = chs
  if len(chs) >= 3:
    far = 0
    for i in range(len(chs)):
      if JMath.abs(chs[i] - ch) > JMath.abs(chs[far] - ch):
        far = i
    rest = []
    for i in range(len(chs)):
      if i != far:
        rest.append(chs[i])
  rl = lo_hi(rest)
  swing = 0.0
  if ch > 0:
    swing = (rl[1] - rl[0]) / ch * 100.0
  ask_info[item] = {"cheapest": ch, "normal": nm, "n": n, "dump": ch < nm * (1.0 - OUTLIER_PCT / 100.0),
                    "reads": len(chs), "lo": lh[0], "hi": lh[1], "swing": swing}
  return None

def st_mm_judge(d):
  global mm_next_scan, mm_pending
  c = d["cfg"]
  item = c["item"]
  lab = label_of(c)
  mm_merge_samples(item)
  top = top_price["mm"]
  if mm_round is not None:
    set_item(mm_round["cfg"])
  if top is None:
    mm_note(item, "§cno orders")
    say("SPREAD " + lab + ": no buy orders for it - nobody to compete with, can't price a bid. NOT WORTH IT")
    if not d["scan_only"]:
      mm_next_scan = tick_count + to_int(RESCAN_MIN * 1200)
    return True
  bid = bid_price("mm", top)
  res = mm_numbers(c, bid)
  info = None
  if item in ask_info:
    info = ask_info[item]
  if (res["ok"] and SCAN_MAX_SWING_PCT > 0 and c["price"] == "auto" and info is not None
      and dget(info, "swing", 0) > SCAN_MAX_SWING_PCT):
    res["ok"] = False
    res["why"] = ("the auction price jumped around " + trim_num(info["swing"]) + "% between the reads ("
                  + fmt_money(info["lo"]) + " - " + fmt_money(info["hi"]) + ") - unsteady, not buying yet")
  if res["ask"] is None:
    mm_note(item, "§cno AH price")
    say("SPREAD " + lab + ": buyers pay " + fmt_money(top) + " (you'd bid " + fmt_money(bid) + "), but " + res["why"] + ". NOT WORTH IT")
    if not d["scan_only"]:
      mm_next_scan = tick_count + to_int(RESCAN_MIN * 1200)
    return True
  ask_txt = fmt_money(res["ask"])
  if c["price"] != "auto":
    ask_txt = ask_txt + " (your fixed price)"
  elif res["dump"]:
    ask_txt = fmt_money(res["ask"]) + " (cheapest is a dump - using the normal price)"
  elif info is not None and dget(info, "reads", 1) > 1:
    ask_txt = fmt_money(res["ask"]) + " (middle of " + str(info["reads"]) + " reads: " + fmt_money(info["lo"]) + " - " + fmt_money(info["hi"]) + ")"
  elif info is not None:
    ask_txt = fmt_money(res["ask"]) + " (cheapest of " + str(info["n"]) + " listings read)"
  say("SPREAD " + lab + ": buyers pay " + fmt_money(top) + " -> you'd bid " + fmt_money(bid) + " | auction sells at " + ask_txt)
  want_txt = trim_num(margin_of(c)) + "%"
  if dget(res, "vol", None) is not None and VOL_K > 0:
    want_txt = (trim_num(res["need"]) + "% = your " + trim_num(margin_of(c)) + "% + price swings ±" + trim_num(res["vol"]) + "%")
  else:
    want_txt = want_txt + ", no swing history yet"
  say("  profit per item: " + fmt_money(res["net"] - bid) + " = " + trim_num(res["pct"]) + "% (you want " + want_txt
      + ") | rough: " + fmt_money(res["rnet"] - res["rbid"]) + " = " + trim_num(res["rpct"]) + "%")
  q = res["qty"]
  if dget(res, "capped", False):
    say("  size: " + str(q) + " - last round sold ~" + str(to_int(res["rate"])) + "/h, so about " + num_str(SELL_HOURS) + "h of sales")
  say("  " + str(q) + " items: spend " + fmt_money(q * bid) + ", make about " + fmt_money(q * (res["net"] - bid))
      + " (rough " + fmt_money(q * (res["rnet"] - res["rbid"])) + ")")
  if info is not None and info["n"] >= 20:
    say("  note: " + str(info["n"]) + "+ listings are up - a crowded market sells slowly")
  if res["ok"]:
    mm_note(item, "§a" + trim_num(res["pct"]) + "% ok")
  else:
    mm_note(item, "§c" + trim_num(res["pct"]) + "% no")
  if not res["ok"]:
    say("  -> NOT WORTH IT: " + res["why"])
    if not d["scan_only"]:
      mm_next_scan = tick_count + to_int(RESCAN_MIN * 1200)
      say("  checking again in " + num_str(RESCAN_MIN) + " min")
    return True
  if dget(d, "survey", False):
    say("  -> WORTH IT")
    mm_cands.append([c, res])
    return True
  if d["scan_only"]:
    say("  -> WORTH IT. (scan only - nothing bought. Start \\marketmaker to trade it)")
    return True
  if mm_peek_found > 0:
    say("  -> WORTH IT, but you already have an unfinished " + lab + " order (or items to collect) in Your Orders - finish or cancel it first. Checking again in " + num_str(RESCAN_MIN) + " min")
    mm_next_scan = tick_count + to_int(RESCAN_MIN * 1200)
    return True
  mm_pending = res
  if MM_MODE == "auto":
    say("  -> WORTH IT: ordering")
    mm_start_round(c, res)
    return True
  say("  -> WORTH IT")
  ask_confirm(c, "Order " + str(q) + " " + lab + " at " + fmt_money(bid) + " each (" + fmt_money(q * bid) + ")?")
  return True

def mm_score(c, res):
  if PICK_BY == "percent":
    return res["pct"]
  return res["qty"] * (res["net"] - res["bid"])

def st_mm_pick(d):
  global mm_next_scan, mm_pending, mm_pending_cfg, mm_cands
  keep = []
  for e in mm_cands:
    if is_on(e[0]) and cfg_of(e[0]["item"]) is not None:
      keep.append(e)
  mm_cands = keep
  if len(mm_cands) == 0:
    mm_next_scan = tick_count + to_int(RESCAN_MIN * 1200)
    say("nothing on the list is worth it right now - reading all spreads again in " + num_str(RESCAN_MIN) + " min")
    return True
  best = None
  for e in mm_cands:
    if best is None or mm_score(e[0], e[1]) > mm_score(best[0], best[1]):
      best = e
  others = []
  for e in mm_cands:
    if e is not best:
      others.append(label_of(e[0]) + " " + trim_num(e[1]["pct"]) + "%")
  txt = "BEST: " + label_of(best[0]) + " (" + trim_num(best[1]["pct"]) + "%, about " + fmt_money(best[1]["qty"] * (best[1]["net"] - best[1]["bid"])) + " this round)"
  if len(others) > 0:
    txt = txt + " - also worth it: " + ", ".join(others)
  say(txt)
  mm_pending = best[1]
  mm_pending_cfg = best[0]
  set_item(best[0])
  steps.insert(1, [st_collect, {"phase": 0, "peek": True}])
  steps.insert(2, [st_mm_go, {"phase": 0}])
  return True

def st_mm_go(d):
  global mm_next_scan
  c = mm_pending_cfg
  res = mm_pending
  lab = label_of(c)
  if mm_peek_found > 0:
    say("you already have an unfinished " + lab + " order (or items to collect) in Your Orders - finish or cancel it first. Reading the spreads again in " + num_str(RESCAN_MIN) + " min")
    mm_next_scan = tick_count + to_int(RESCAN_MIN * 1200)
    return True
  if MM_MODE == "auto":
    say("ordering " + lab)
    mm_start_round(c, res)
    return True
  ask_confirm(c, "Order " + str(res["qty"]) + " " + lab + " at " + fmt_money(res["bid"]) + " each (" + fmt_money(res["qty"] * res["bid"]) + ")?")
  return True

def mm_confirmed(c, yes):
  global mm_next_scan
  if yes and mm_pending is not None:
    mm_start_round(c, mm_pending)
  else:
    mm_next_scan = tick_count + to_int(RESCAN_MIN * 1200)
    say("ok - not ordering, checking again in " + num_str(RESCAN_MIN) + " min")

def mm_start_round(c, res):
  global mm_round, mm_next_collect, mm_last_rebid
  item = c["item"]
  set_item(c)
  qty = res["qty"]
  mm_round = {"cfg": c, "item": item, "phase": "buying", "qty": qty, "qty_total": qty * 1.0, "spent": 0.0,
              "order_price": res["bid"] * 1.0, "bought": 0.0, "first_got": -1, "t0": tick_count, "sell_t": -1, "sold0": get0(sold, item),
              "income0": get0(money_in, item), "order_made": -1, "seen": [], "seen_tick": -1,
              "ask": res["ask"], "bid": res["bid"], "plan": qty * (res["net"] - res["bid"])}
  mm_collected[item] = 0
  placed[item] = 0
  for k in dump_wait:
    dump_wait[k] = False
  for k in below_cost:
    below_cost[k] = False
  forget_done(item)
  mm_next_collect = tick_count + 10 * 20
  mm_last_rebid = tick_count
  say("NEW ROUND: ordering " + str(qty) + " " + label_of(c) + " at " + fmt_money(res["bid"]) + " each = " + fmt_money(qty * res["bid"])
      + " paid (expected to sell for about " + fmt_money(qty * res["net"]) + ")")
  steps.insert(1, [st_create, {"phase": 0, "key": "mm", "amount": qty, "price": res["bid"]}])

def left_to_list(c):
  have = total_of(c["item"])
  n = get0(mm_collected, c["item"]) - get0(placed, c["item"])
  if n > have:
    n = have
  if n < 0:
    n = 0
  return n

def item_done(c):
  return left_to_list(c) <= 0 and item_listed(c["item"]) == 0

def st_mm_rebid(d):
  r = mm_round
  if r is None or r["phase"] != "buying" or r["order_made"] < 0:
    return True
  set_item(r["cfg"])
  steps.insert(1, [st_read_top, {"phase": 0, "key": "mm"}])
  steps.insert(2, [st_recon, {"phase": 0, "cfg": r["cfg"]}])
  steps.insert(3, [st_mm_rebid_decide, {"phase": 0}])
  return True

def st_mm_rebid_decide(d):
  r = mm_round
  if r is None or r["phase"] != "buying":
    return True
  mine = None
  for o in r["seen"]:
    if not o["completed"]:
      mine = o
  if mine is None:
    return True
  top = top_price["mm"]
  if top is None or top <= mine["price"] + 0.5:
    return True
  left = mine["requested"] - mine["delivered"]
  if left < 1:
    return True
  c = r["cfg"]
  lab = label_of(c)
  new = bid_price("mm", top)
  res = mm_numbers(c, new)
  head = ("OUTBID on " + lab + ": best order is " + fmt_money(top) + ", yours " + fmt_money(mine["price"]) + ", "
          + str(to_int(left)) + " still missing")
  if res["ask"] is None:
    say(head + " - no auction price to check the margin, not re-bidding")
    return True
  if not res["ok"]:
    key = str(top)
    if lab not in mm_noted or mm_noted[lab] != key:
      mm_noted[lab] = key
      say(head + ". Re-bidding at " + fmt_money(new) + " would earn " + trim_num(res["pct"]) + "% (rough " + trim_num(res["rpct"])
          + "%) - not re-bidding: " + res["why"] + ". Your order stays")
    return True
  say(head + ". Re-bidding at " + fmt_money(new) + " (" + fmt_money((new - mine["price"]) * left) + " more) - still " + trim_num(res["pct"]) + "% profit")
  steps.insert(1, [st_rebid, {"phase": 0, "id": r["item"], "key": "mm", "old_price": mine["price"], "new_price": new}])
  return True

def mm_order_done(r):
  if r["order_made"] < 0 or r["seen_tick"] < r["order_made"]:
    return False
  if len(r["seen"]) == 0:
    return True
  for o in r["seen"]:
    if not o["completed"] or o["key"] not in done_orders:
      return False
  return True

def mm_status():
  r = mm_round
  if r is None:
    return "between rounds"
  item = r["item"]
  c = r["cfg"]
  s = (r["phase"] + ": " + label_of(c) + " - bought " + str(to_int(r["bought"])) + "/" + str(to_int(r["qty"])) + " (spent "
       + fmt_money(r["spent"]) + "), " + str(to_int(item_listed(item))) + " up on the auction, " + str(to_int(get0(sold, item)))
       + " sold so far, " + fmt_money(get0(money_in, item) - r["income0"]) + " in")
  return s

def mm_check_finished():
  global mm_round, mm_next_scan, mm_session, mm_rounds_done, mm_last_round, mm_between
  r = mm_round
  if r is None:
    return
  item = r["item"]
  c = r["cfg"]
  if r["phase"] == "buying":
    if mm_order_done(r):
      r["phase"] = "selling"
      r["sell_t"] = tick_count
      avg = 0.0
      if r["bought"] > 0:
        avg = r["spent"] / r["bought"]
      say("order complete: bought " + str(to_int(r["bought"])) + " " + label_of(c) + " for " + fmt_money(r["spent"]) + " ("
          + fmt_money(avg) + " each) - selling the rest")
    return
  if last_sync < 0 or last_sync <= last_list_tick:
    return
  if left_to_list(c) > 0 or item_listed(item) > 0:
    return
  income = get0(money_in, item) - r["income0"]
  profit = income - r["spent"]
  rmins = (tick_count - r["t0"]) / 1200.0
  pct = 0.0
  if r["spent"] > 0:
    pct = profit / r["spent"] * 100.0
  mm_session = mm_session + profit
  mm_rounds_done = mm_rounds_done + 1
  say("ROUND DONE - " + label_of(c) + ": spent " + fmt_money(r["spent"]) + ", sold for " + fmt_money(income) + " = profit "
      + fmt_money(profit) + " (" + trim_num(pct) + "%) in " + trim_num(rmins) + " min (planned " + fmt_money(r["plan"])
      + "). Session: " + str(mm_rounds_done) + " rounds, " + fmt_money(mm_session))
  rr = round_rate(r)
  if rr is not None:
    mm_rate[item] = rr
  st = r["sell_t"]
  if st < 0:
    st = tick_count
  mm_last_round = (label_of(c) + " " + money_col(profit) + " (" + trim_num(pct) + "%): paid " + fmt_money(r["spent"]) + " for "
                   + str(to_int(r["bought"])) + ", sold for " + fmt_money(income) + " - ordering " + clock(st - r["t0"]) + ", selling " + clock(tick_count - st))
  mm_round = None
  mm_next_scan = tick_count + 40
  if BETWEEN_SEC > 0:
    mm_between = tick_count + to_int(BETWEEN_SEC * 20)
    mm_next_scan = mm_between
    System.setProperty(ANSWER_KEY, "")
    say(">>> next round in " + num_str(BETWEEN_SEC) + "s: \\yes = start it now, \\no = stop here (nothing is open - safe). No answer = it carries on")

def st_check(d):
  global last_check
  if not check_due():
    return True
  last_check = tick_count
  for c in SELL:
    if c["price"] == "auto":
      if left_to_list(c) > 0 or item_listed(c["item"]) > 0:
        steps.insert(1, [st_recon, {"phase": 0, "cfg": c}])
    else:
      prices[c["item"]] = c["price"] * 1.0
  return True

def st_wait(d):
  global last_heartbeat
  if d["phase"] == 0:
    d["until"] = tick_count + FULL_RECHECK_SEC * 20 + hdelay(0, 20)
    if next_to_list() is not None and ah_free != 0:
      d["until"] = tick_count + hdelay(10, 30)
    d["phase"] = 1
    return False
  if tick_count - last_heartbeat > 2400:
    last_heartbeat = tick_count
    say("still running - " + mm_status() + " (" + str(ah_free) + " free auction slots)")
  if sale_ping and mm_round is not None:
    return True
  return tick_count >= d["until"]

def st_mm_sync(d):
  ph = d["phase"]
  if ph == 0:
    if last_sync >= 0 and tick_count - last_sync < SYNC_SEC * 20:
      return True
    close_all()
    send_cmd(AH_CMD)
    d["t0"] = tick_count
    d["phase"] = 1
    wait(hd(6, 12))
    return False
  if ph == 1:
    m = container_open()
    if ah_open_ok(m):
      d["prev"] = menu_id(m)
      click(m, slot_named(m, "your items"), 0, 0)
      d["phase"] = 2
      d["t0"] = tick_count
      wait(hd(6, 12))
      return False
    if timed_out(d, 130):
      say("/ah didn't open")
      close_all()
      return True
    return False
  m = container_open()
  if m is None or (menu_id(m) == d["prev"] and "your items" not in screen_title()):
    if timed_out(d, 130):
      say("Your Items didn't open")
      close_all()
      return True
    return False
  if "loaded" not in d:
    d["loaded"] = tick_count
    return False
  if tick_count - d["loaded"] < 5:
    return False
  sync_your_items(m)
  close_all()
  wait(hd(6, 10))
  return True

def st_mm_idle(d):
  if d["phase"] == 0:
    d["until"] = tick_count + 100
    d["phase"] = 1
    return False
  return tick_count >= d["until"] or tick_count >= mm_next_scan

def push(fn, data):
  data["phase"] = 0
  steps.append([fn, data])

def plan_cycle():
  global mm_next_collect, mm_last_rebid, mm_cands, menu_request, mm_between, mm_cands_t, mm_scan_survey, mm_next_scan
  global mm_all_up, last_sync
  take_sale_ping()
  if mm_scan_only and len(mm_scan_queue) == 0 and mm_round is None:
    say("scan done - nothing was bought")
    shutdown(None)
    return
  if len(mm_scan_queue) == 0 and mm_scan_survey:
    mm_scan_survey = False
    mm_cands_t = tick_count
  if not trading and len(mm_scan_queue) == 0:
    if menu is None and menu_request is None:
      menu_request = "main"
    return
  push(st_eat, {})
  if len(mm_scan_queue) > 0:
    c = mm_scan_queue[0]
    del mm_scan_queue[0]
    push(st_mm_begin, {"cfg": c, "scan_only": True, "survey": mm_scan_survey})
    return
  if len(SELL) == 0:
    shutdown("MM: the trade list is empty - stopped")
    return
  if mm_round is None:
    if tick_count >= mm_next_scan and mm_cands_t >= 0 and tick_count - mm_cands_t < FRESH_SCAN_MIN * 1200:
      mm_cands_t = -1
      mm_between = -1
      say("using the spreads you just scanned")
      push(st_mm_pick, {})
      return
    if tick_count >= mm_next_scan:
      mm_between = -1
      mm_cands_t = -1
      mm_cands = []
      act = active_list()
      if len(act) == 0:
        say("every item is switched off - switch one on in the menu (M)")
        mm_next_scan = tick_count + to_int(RESCAN_MIN * 1200)
        return
      if len(act) > 1:
        say("reading the spreads of your " + str(len(act)) + " switched-on items, then picking the best")
      for c in act:
        push(st_mm_begin, {"cfg": c, "scan_only": True, "survey": True})
      push(st_mm_pick, {})
    else:
      push(st_mm_idle, {})
    return
  mm_check_finished()
  r = mm_round
  if r is None:
    return
  if r["phase"] == "buying":
    if tick_count >= mm_next_collect:
      mm_next_collect = tick_count + CHECK_ORDERS_SEC * 20
      push(st_collect, {})
    if REBID and tick_count - mm_last_rebid >= REBID_CHECK_MIN * 1200:
      mm_last_rebid = tick_count
      push(st_mm_rebid, {})
  push(st_check, {})
  push(st_list, {})
  if next_to_list() is None and len(listed) > 0:
    if not mm_all_up:
      mm_all_up = True
      last_sync = -1
    push(st_mm_sync, {})
  else:
    mm_all_up = False
  push(st_wait, {})

def mm_queue_scans(names):
  global mm_scan_queue
  cfgs = []
  if len(names) == 0:
    for c in SELL:
      cfgs.append(c)
  else:
    for nm in names:
      item = item_arg(nm)
      if item is None:
        say("give the item's name")
        continue
      c = cfg_of(item)
      if c is None:
        c = {"item": item, "total": 64, "per_listing": 1, "price": "auto", "min": None, "max": None, "margin": None,
             "maxbuy": None, "label": None}
      cfgs.append(c)
  for c in cfgs:
    mm_scan_queue.append(c)
  if len(cfgs) == 0:
    say("nothing to scan - add an item first (\\marketmaker add end_crystal 64) or name one: \\marketmaker scan diamond")

def check_scan_request():
  v = System.getProperty(SCAN_KEY)
  if v is None or str(v) == "":
    return
  System.setProperty(SCAN_KEY, "")
  want_names = []
  if str(v) != "*":
    for x in str(v).split(" "):
      if x != "":
        want_names.append(x)
  mm_queue_scans(want_names)

sale_ping = False
sale_hook = None

def on_in_chat(event):
  global sale_ping
  try:
    m = strip_codes(str(event.message)).lower()
    if " bought your " in m and " for $" in m:
      sale_ping = True
  except Exception:
    pass

def hook_sales(on):
  global sale_hook
  if on and sale_hook is None:
    try:
      sale_hook = add_event_listener("chat", on_in_chat)
    except Exception as e:
      say("can't read sale messages from chat (" + short_error(e) + ") - it'll still see sales every few seconds")
  if not on and sale_hook is not None:
    try:
      remove_event_listener(sale_hook)
    except Exception:
      pass
    sale_hook = None

def take_sale_ping():
  global sale_ping, last_sync
  if not sale_ping:
    return False
  sale_ping = False
  if mm_round is not None:
    last_sync = -1
  return True

def setup():
  global set_up, mm_scan_only, trading, menu_request
  load_list()
  if SALE_CHAT:
    hook_sales(True)
  if not find_click():
    shutdown("MM: can't find Minecraft's inventory click method in this version - send me this line.")
    return
  if screen_mode is None:
    find_screen_access()
  if disable_pause_on_focus_loss():
    say("pause-on-lost-focus is off while I run (back on when I stop)")
  if SCAN_NAMES is not None:
    mm_scan_only = True
    mm_queue_scans(SCAN_NAMES)
    setup_hud()
    set_up = True
    return
  setup_hud()
  if len(SELL) == 0 or MENU_START or (START_WITH_MENU and not GO_START):
    set_up = True
    trading = False
    menu_request = "main"
    return
  for c in SELL:
    if c["total"] is None or c["total"] < 1:
      shutdown("MM: set a buy amount for " + c["item"] + " (\\marketmaker set " + c["item"] + " amount 64)")
      return
    if c["per_listing"] < 1 or c["per_listing"] > 64:
      shutdown("MM: per_listing for " + c["item"] + " must be 1 to 64")
      return
  show_list()
  say("starting in " + MM_MODE.upper() + " mode - it reads the spread first and only buys when it's worth it")
  set_up = True

shut_done = False

def shutdown(message):
  global shut_done
  if shut_done:
    return
  shut_done = True
  try:
    hook_chat(False)
  except Exception:
    pass
  try:
    hook_sales(False)
  except Exception:
    pass
  try:
    hide_gui(False)
  except Exception:
    pass
  set_hud_lines(None)
  restore_pause_on_focus_loss()
  hold_right_click(False)
  if str(System.getProperty(RUN_KEY)) == my_token:
    System.setProperty(RUN_KEY, "")
  try:
    close_all()
  except Exception:
    pass
  remove_event_listener(listener_id)
  if mm_round is not None:
    print("§dMM:§r stopped in the middle of a round (" + mm_status() + "). Your order and items stay as they are - it won't pick that round up again, so finish it by hand")
  if message is not None:
    print("§c" + message)
  end_job()

def end_job():
  for cb in [hud_cb, menu_cb, menu_bg_cb, menu_icon_cb]:
    if cb is not None:
      try:
        cb.cancel()
      except Exception:
        pass
  try:
    exit(0)
  except Exception:
    pass

def on_tick(event):
  global tick_count, last_hp
  if str(System.getProperty(RUN_KEY)) != my_token:
    shutdown("MM stopped.")
    return
  System.setProperty(BEAT_KEY, str(System.currentTimeMillis()))
  try:
    if mc.player is None or mc.level is None:
      return
    tick_count += 1
    if not set_up:
      if tick_count > 5:
        setup()
      return
    if STOP_ON_DAMAGE:
      hp = mc.player.getHealth()
      if last_hp is not None and hp < last_hp - 0.01:
        shutdown("MM: you took damage - stopped.")
        return
      last_hp = hp
    check_reload()
    check_wizard_request()
    check_scan_request()
    check_menu_request()
    key_tick()
    answer_tick()
    mm_hud_tick()
    if menu_open_now():
      return
    if menu_tick():
      return
    if wizard_tick():
      return
    if typer is None and user_typing():
      return
    if typer_tick():
      return
    if tick_count < wait_until:
      return
    if close_pause_menu():
      wait(5)
      return
    if len(steps) == 0:
      if menu is not None or menu_request is not None:
        return
      plan_cycle()
      if len(steps) == 0:
        return
    s = steps[0]
    if s[0](s[1]):
      if len(steps) > 0 and steps[0] is s:
        del steps[0]
  except Exception as e:
    if shut_done:
      return
    shutdown("MM stopped because of an error: " + short_error(e))

typing_since = -1

def user_typing():
  global typing_since
  scr = get_screen()
  if scr is not None and is_chat_screen(scr):
    if typing_since < 0:
      typing_since = tick_count
    if tick_count - typing_since > 45 * 20:
      close_all()
      typing_since = -1
      return False
    return True
  typing_since = -1
  return False

def answer_tick():
  global mm_next_scan, mm_between
  v = System.getProperty(ANSWER_KEY)
  if v is None or str(v) == "":
    return
  System.setProperty(ANSWER_KEY, "")
  a = str(v).strip().lower()
  if menu is not None and menu["kind"] == "confirm" and "scr" in menu and a in ["yes", "no", "auto"]:
    menu_actions.append(a)
    return
  if mm_round is None and mm_between > tick_count:
    if a == "yes" or a == "auto":
      mm_between = -1
      mm_next_scan = tick_count
      say("ok - next round now")
      return
    if a == "no":
      mm_between = -1
      say("ok - stopping between rounds. Session: " + str(mm_rounds_done) + " rounds, " + fmt_money(mm_session))
      shutdown("MM stopped (you said \\no).")
      return
  say("nothing to answer right now ('" + a + "')")

ARGS = []
try:
  import sys
  for a in sys.argv[1:]:
    ARGS.append(str(a))
except Exception:
  ARGS = []

WIZ_START = ""
MENU_START = False
GO_START = False
SCAN_NAMES = None
if len(ARGS) >= 1 and ARGS[0].lower() == "scan":
  scan_names = []
  for a in ARGS[1:]:
    scan_names.append(a)
  if other_run_alive():
    if len(scan_names) == 0:
      System.setProperty(SCAN_KEY, "*")
    else:
      System.setProperty(SCAN_KEY, " ".join(scan_names))
    print("§dMM:§r scanning - the result shows in chat in a moment")
    ARGS = ["-"]
  else:
    SCAN_NAMES = scan_names
    ARGS = []
elif len(ARGS) == 1 and ARGS[0].lower() in ["go", "start", "run"]:
  if other_run_alive():
    print("§dMM:§r it's already running")
    ARGS = ["-"]
  else:
    GO_START = True
    ARGS = []
elif len(ARGS) == 1 and ARGS[0].lower() in ["menu", "new", "add", "edit"]:
  if other_run_alive():
    System.setProperty(MENU_KEY, "1")
    print("§dMM:§r opening the menu (as soon as it's done with what it's doing)")
    ARGS = ["-"]
  else:
    MENU_START = True
    ARGS = []
if len(ARGS) == 1 and ARGS[0] == "-":
  pass
elif len(ARGS) > 0:
  try:
    run_command(ARGS)
  except Exception as e:
    print("MM: that command failed: " + short_error(e))
elif other_run_alive():
  System.setProperty(RUN_KEY, "")
  print("MM stopping...")
else:
  my_token = str(System.nanoTime())
  System.setProperty(RUN_KEY, my_token)
  System.setProperty(BEAT_KEY, str(System.currentTimeMillis()))
  listener_id = add_event_listener("tick", on_tick)
  if MENU_START or (START_WITH_MENU and not GO_START and SCAN_NAMES is None):
    print("MM: opening the menu - nothing is bought until you press Start trading.")
  elif SCAN_NAMES is not None:
    print("MM: reading the spread (scan only - nothing gets bought). Don't touch the mouse or keyboard while it works.")
  else:
    print("MM running. Don't touch the mouse or keyboard while it works. Run \\marketmaker again to stop.")
