def say(msg):
  if VERBOSE:
    msg = prettify(msg)
    c = say_color(msg)
    print("§d§lMM:§r " + c + msg.replace("§r", "§r" + c))

def say_color(msg):
  m = msg.lower()
  if ">>>" in m or "\\yes" in m or "waiting for you" in m:
    return "§e"
  if ("done" in m or "profit" in m or "round" in m) and "-$" in m:
    return "§c"
  for w in ["stopped", "error", "not worth", "not buying", "not listing", "not re-bidding", "couldn't", "can't",
            "didn't", "outbid", "below min", "dumping", "failed", "wrong", "loss", "cancelling", "won't", "no buy orders"]:
    if w in m:
      return "§c"
  for w in ["sold", "listed", "created order", " done", "worth it", "margin ok", "collected", "ordering", "listing at",
            "bought"]:
    if w in m:
      return "§a"
  for w in ["still running", "checking", "reading", "new round", "picking", "typing", "pause-on-lost-focus", "spread"]:
    if w in m:
      return "§7"
  return "§f"

def strip_codes(t):
  out = ""
  skip = False
  for ch in t:
    if skip:
      skip = False
      continue
    if ch == "§":
      skip = True
      continue
    out = out + ch
  return out

Minecraft = JavaClass("net.minecraft.client.Minecraft")

JMath = JavaClass("java.lang.Math")

JDouble = JavaClass("java.lang.Double")

MAX_SEARCH_PAGES = 20

def to_int(v):
  return JDouble.valueOf(str(v)).intValue()

def short_error(e):
  return str(e).split("\n")[0]

mc = Minecraft.getInstance()

wait_until = 0

tick_count = 0

def rnd():
  return JMath.random()

def hdelay(lo, hi):
  r = (rnd() + rnd()) / 2.0
  d = lo + (hi - lo) * r
  if rnd() < 0.06:
    d = d + 8 + rnd() * 25
  return to_int(d)

def wait(d):
  global wait_until
  wait_until = tick_count + d

click_method = None

click_kinds = None

click_names = ""

def kind_matches(n, rule):
  if rule.startswith("exact:"):
    return n == rule[6:]
  parts = rule.split(",")
  for p in parts:
    if p.startswith("has:") and p[4:] not in n:
      return False
    if p.startswith("not:") and p[4:] in n:
      return False
  return True

def pick_kind(consts, rule):
  for c in consts:
    if kind_matches(str(c.name()).upper(), rule):
      return c
  return None

def find_click():
  global click_method, click_kinds, click_names
  for m in mc.gameMode.getClass().getMethods():
    pt = m.getParameterTypes()
    if len(pt) != 5:
      continue
    if str(pt[0].getName()) != "int" or str(pt[1].getName()) != "int" or str(pt[2].getName()) != "int":
      continue
    if not pt[3].isEnum() or not pt[4].isInstance(mc.player):
      continue
    consts = pt[3].getEnumConstants()
    names = []
    for c in consts:
      names.append(str(c.name()))
    click_names = ", ".join(names)
    pickup = pick_kind(consts, "exact:PICKUP")
    if pickup is None:
      pickup = pick_kind(consts, "has:PICK,not:ALL")
    quick = pick_kind(consts, "exact:QUICK_MOVE")
    if quick is None:
      quick = pick_kind(consts, "has:QUICK,not:CRAFT")
    swap = pick_kind(consts, "exact:SWAP")
    if swap is None:
      swap = pick_kind(consts, "has:SWAP")
    if pickup is None or quick is None or swap is None:
      pickup = consts[0]
      quick = consts[1]
      swap = consts[2]
    click_method = m
    click_kinds = [pickup, quick, swap]
    return True
  return False

def item_name(stack):
  if stack is None or stack.isEmpty():
    return ""
  s = str(stack.getItem()).lower().replace("}", "").replace("]", "")
  parts = s.split(":")
  return parts[len(parts) - 1].strip()

def hover(stack):
  try:
    return str(stack.getHoverName().getString()).lower()
  except Exception:
    return ""

def inv():
  return mc.player.getInventory()

def inv_stack(i):
  return inv().getItem(to_int(i))

def free_slots():
  n = 0
  for i in range(36):
    if inv_stack(i).isEmpty():
      n = n + 1
  return n

def selected_slot():
  try:
    return to_int(inv().getSelectedSlot())
  except Exception:
    return to_int(inv().selected)

def cur_menu():
  return mc.player.containerMenu

def menu_id(m):
  return to_int(m.containerId)

def container_size(m):
  return to_int(m.slots.size() - 36)

def slot_stack(m, i):
  return m.slots.get(to_int(i)).getItem()

def inv_to_menu(m, i):
  n = container_size(m)
  if i < 9:
    return to_int(n + 27 + i)
  return to_int(n + i - 9)

def inv_menu_slot(i):
  if i < 9:
    return to_int(36 + i)
  return to_int(i)

last_nav = None

def click(m, slot, button, t):
  global last_nav
  if click_method is None and not find_click():
    raise Exception("can't find Minecraft's inventory click method")
  click_method.invoke(mc.gameMode, JavaArray((menu_id(m), to_int(slot), to_int(button), click_kinds[t], mc.player)))
  last_nav = None
  if t == 0 and button == 0 and to_int(slot) < container_size(m):
    last_nav = [menu_id(m), to_int(slot), tick_count, 0, page_sig(m)]

def reclick_if_missed():
  global last_nav
  if last_nav is None or tick_count - last_nav[2] < 40 or last_nav[3] >= 2:
    return False
  m = container_open()
  if m is None or menu_id(m) != last_nav[0] or page_sig(m) != last_nav[4]:
    return False
  click_method.invoke(mc.gameMode, JavaArray((menu_id(m), last_nav[1], 0, click_kinds[0], mc.player)))
  last_nav[2] = tick_count
  last_nav[3] = last_nav[3] + 1
  say("click didn't go through (lag?) - clicking again (" + str(last_nav[3]) + "/2)")
  return True

screen_mode = None

screen_ref = None

screen_info = ""

screen_type_cache = {}

def looks_like_screen(t):
  try:
    if t.isPrimitive():
      return False
    key = str(t.getName())
    if key in screen_type_cache:
      return screen_type_cache[key]
    r = False
    n = str(t.getSimpleName())
    if n == "Screen" or n == "class_437":
      r = True
    elif not key.startswith("java."):
      names = {}
      for mm in t.getMethods():
        names[str(mm.getName())] = True
      r = ("getTitle" in names) and ("children" in names) and ("onClose" in names)
    screen_type_cache[key] = r
    return r
  except Exception:
    return False

def find_screen_access():
  global screen_mode, screen_ref, screen_info
  try:
    s = mc.screen
    screen_mode = "field"
    return
  except Exception as e:
    screen_info = "mc.screen: " + short_error(e)
  try:
    s = mc.getScreen()
    screen_mode = "getScreen"
    return
  except Exception:
    pass
  try:
    for m in mc.getClass().getMethods():
      if len(m.getParameterTypes()) == 0 and looks_like_screen(m.getReturnType()):
        screen_mode = "method"
        screen_ref = m
        screen_info = "using method " + str(m.getName())
        return
  except Exception as e:
    screen_info = screen_info + "; methods: " + short_error(e)
  seen = []
  try:
    cls = mc.getClass()
    while cls is not None:
      for f in cls.getDeclaredFields():
        tn = str(f.getType().getSimpleName())
        if "creen" in tn:
          seen.append(str(f.getName()) + ":" + tn)
        if looks_like_screen(f.getType()):
          f.setAccessible(True)
          screen_mode = "reflect_field"
          screen_ref = f
          screen_info = "using field " + str(f.getName())
          return
      cls = cls.getSuperclass()
  except Exception as e:
    screen_info = screen_info + "; fields: " + short_error(e)
  Modifier = JavaClass("java.lang.reflect.Modifier")
  try:
    cls = mc.getClass()
    while cls is not None:
      for f in cls.getDeclaredFields():
        try:
          if Modifier.isStatic(f.getModifiers()) or f.getType().isPrimitive():
            continue
          tn = str(f.getType().getName())
          if tn.startswith("java.") or tn.startswith("javax.") or tn.startswith("com.mojang.blaze3d"):
            continue
          f.setAccessible(True)
          v = f.get(mc)
          if v is None:
            continue
          vc = v.getClass()
          for m in vc.getMethods():
            if len(m.getParameterTypes()) == 0 and looks_like_screen(m.getReturnType()):
              screen_mode = "chain_method"
              screen_ref = [f, m]
              screen_info = "using " + str(f.getName()) + "." + str(m.getName()) + "()"
              return
          c2 = vc
          while c2 is not None:
            for f2 in c2.getDeclaredFields():
              if looks_like_screen(f2.getType()):
                f2.setAccessible(True)
                screen_mode = "chain_field"
                screen_ref = [f, f2]
                screen_info = "using " + str(f.getName()) + "." + str(f2.getName())
                return
            c2 = c2.getSuperclass()
        except Exception:
          pass
      cls = cls.getSuperclass()
  except Exception as e:
    screen_info = screen_info + "; deep search: " + short_error(e)
  screen_mode = "none"
  screen_info = screen_info + "; screen-like fields: " + ", ".join(seen)

def get_screen():
  if screen_mode is None:
    find_screen_access()
  try:
    if screen_mode == "field":
      return mc.screen
    if screen_mode == "getScreen":
      return mc.getScreen()
    if screen_mode == "method":
      return screen_ref.invoke(mc, JavaArray(()))
    if screen_mode == "reflect_field":
      return screen_ref.get(mc)
    if screen_mode == "chain_method":
      return screen_ref[1].invoke(screen_ref[0].get(mc), JavaArray(()))
    if screen_mode == "chain_field":
      return screen_ref[1].get(screen_ref[0].get(mc))
  except Exception:
    pass
  return None

def screen_title():
  try:
    scr = get_screen()
    if scr is None:
      return ""
    return str(scr.getTitle().getString()).lower()
  except Exception:
    return ""

def close_all():
  try:
    if menu_id(cur_menu()) != 0:
      mc.player.closeContainer()
  except Exception:
    pass
  try:
    scr = get_screen()
    if scr is not None:
      try:
        scr.onClose()
      except Exception:
        pass
      if get_screen() is not None:
        set_screen(None)
  except Exception:
    pass

def send_cmd_direct(cmd):
  mc.getConnection().sendCommand(cmd)

typer = None

typing_failed = False

def one_arg(v):
  if v is not None:
    return JavaArray((v,))
  Arr = JavaClass("java.lang.reflect.Array")
  return Arr.newInstance(JavaClass("java.lang.Object")().getClass(), to_int(1))

def set_screen(scr):
  if scr is not None:
    try:
      mc.setScreen(scr)
      return True
    except Exception:
      pass
  for target in [mc, mc.gui]:
    try:
      for m in named_methods(target, "setScreen", 1):
        m.invoke(target, one_arg(scr))
        if scr is None and get_screen() is not None:
          continue
        return True
    except Exception:
      pass
  if scr is None:
    cur = get_screen()
    if cur is not None:
      try:
        cur.onClose()
        return True
      except Exception:
        pass
  return False

def close_chat(scr):
  try:
    scr.onClose()
  except Exception:
    pass
  if same_obj(get_screen(), scr):
    set_screen(None)

def make_chat_screen():
  Cls = JavaClass("net.minecraft.client.gui.screens.ChatScreen")
  try:
    return Cls("")
  except Exception:
    pass
  try:
    return Cls("", False)
  except Exception:
    pass
  cls = make_chat_screen_class_obj()
  if cls is None:
    return None
  for c in cls.getConstructors():
    ct = c.getParameterTypes()
    if len(ct) >= 1 and str(ct[0].getName()) == "java.lang.String":
      args = [""]
      ok = True
      for k in range(1, len(ct)):
        if str(ct[k].getName()) == "boolean":
          args.append(False)
        else:
          ok = False
      if ok:
        return c.newInstance(JavaArray(tuple(args)))
  return None

def make_chat_screen_class_obj():
  try:
    return JavaClass("java.lang.Class").forName("net.minecraft.client.gui.screens.ChatScreen")
  except Exception:
    return None

def find_field(obj, name):
  cls = obj.getClass()
  while cls is not None:
    for f in cls.getDeclaredFields():
      if str(f.getName()) == name:
        f.setAccessible(True)
        return f.get(obj)
    cls = cls.getSuperclass()
  return None

def same_obj(a, b):
  if a is None or b is None:
    return False
  return System.identityHashCode(a) == System.identityHashCode(b)

def type_fail(reason):
  global typing_failed
  typing_failed = True
  say("can't type in the chat box on this version (" + reason + ") - sending commands directly instead")

def send_cmd(cmd):
  global typer
  if not TYPE_COMMANDS or typing_failed:
    send_cmd_direct(cmd)
    return
  try:
    scr = make_chat_screen()
    if scr is None:
      type_fail("no chat screen")
      send_cmd_direct(cmd)
      return
    if not set_screen(scr) or not same_obj(get_screen(), scr):
      type_fail("chat box didn't open")
      send_cmd_direct(cmd)
      return
    box = find_field(scr, "input")
    if box is None:
      type_fail("no input box")
      set_screen(None)
      send_cmd_direct(cmd)
      return
    box.setValue("")
    typer = {"text": "/" + cmd, "pos": 0, "scr": scr, "box": box, "cmd": cmd,
             "next": tick_count + hdelay(3, 7), "done": False}
  except Exception as e:
    type_fail(short_error(e))
    try:
      set_screen(None)
    except Exception:
      pass
    send_cmd_direct(cmd)

def typer_tick():
  global typer
  if typer is None:
    return False
  T = typer
  if tick_count < T["next"]:
    return True
  if not same_obj(get_screen(), T["scr"]):
    typer = None
    send_cmd_direct(T["cmd"])
    return False
  try:
    if T["pos"] < len(T["text"]):
      step = 1
      if rnd() < 0.3:
        step = 2
      T["pos"] = T["pos"] + step
      if T["pos"] > len(T["text"]):
        T["pos"] = len(T["text"])
      T["box"].setValue(T["text"][:T["pos"]])
      if T["pos"] >= len(T["text"]):
        T["next"] = tick_count + hdelay(4, 10)
      else:
        T["next"] = tick_count + hdelay(1, 3)
      return True
    typer = None
    close_chat(T["scr"])
    send_cmd_direct(T["cmd"])
    return False
  except Exception as e:
    typer = None
    try:
      set_screen(None)
    except Exception:
      pass
    type_fail(short_error(e))
    send_cmd_direct(T["cmd"])
    return False

def wrap(a):
  return ((a % 360) + 540) % 360 - 180

look = None

look_goal = None

turn_ok = True

def now_ms():
  return System.nanoTime() / 1000000.0

def gauss():
  return (rnd() + rnd() + rnd() + rnd() - 2.0) / 2.0

def plan_move(yaw, pitch, allow_over):
  global look
  p = mc.player
  sy = p.getYRot()
  sp = p.getXRot()
  dy = wrap(yaw - sy)
  dp = pitch - sp
  dist = JMath.sqrt(dy * dy + dp * dp)
  over = False
  if allow_over and dist > 15.0 and rnd() < 0.25:
    k = 1.02 + rnd() * 0.05
    dy = dy * k
    dp = dp * k
    over = True
  dur = 170.0 + 60.0 * JMath.sqrt(dist) + gauss() * 70.0
  if dur < 140.0:
    dur = 140.0
  if dur > 1200.0:
    dur = 1200.0
  bend = gauss() * dist * 0.05
  if bend > 4.0:
    bend = 4.0
  if bend < -4.0:
    bend = -4.0
  nx = 0.0
  nz = 0.0
  if dist > 0.01:
    nx = -dp / dist
    nz = dy / dist
  look = {"sy": sy, "sp": sp, "dy": dy, "dp": dp, "t0": now_ms(), "dur": dur,
          "bend": bend, "nx": nx, "nz": nz, "over": over, "ty": yaw, "tp": pitch,
          "ph1": rnd() * 6.28, "ph2": rnd() * 6.28}

def set_view(ny, np):
  global turn_ok
  p = mc.player
  if np > 90.0:
    np = 90.0
  if np < -90.0:
    np = -90.0
  ddy = wrap(ny - p.getYRot())
  ddp = np - p.getXRot()
  if turn_ok:
    try:
      p.turn(ddy / 0.15, ddp / 0.15)
      return
    except Exception:
      turn_ok = False
  p.setYRot(p.getYRot() + ddy)
  p.setXRot(np)

def apply_look():
  global look
  if look is None or mc.player is None:
    return
  L = look
  t = (now_ms() - L["t0"]) / L["dur"]
  if t < 0.0:
    t = 0.0
  if t > 1.0:
    t = 1.0
  s = t * t * t * (10.0 - 15.0 * t + 6.0 * t * t)
  arc = JMath.sin(3.14159 * t)
  b = L["bend"] * arc
  secs = now_ms() / 1000.0
  tremor = (0.06 * JMath.sin(secs * 7.3 + L["ph1"]) + 0.04 * JMath.sin(secs * 13.1 + L["ph2"])) * arc
  ny = L["sy"] + L["dy"] * s + L["nx"] * b + tremor
  np = L["sp"] + L["dp"] * s + L["nz"] * b + tremor * 0.6
  set_view(ny, np)
  if t >= 1.0:
    if L["over"]:
      plan_move(L["ty"], L["tp"], False)
    else:
      look = None

def ease_look(yaw, pitch):
  global look_goal
  if look_goal is None or JMath.abs(wrap(yaw - look_goal[0])) > 0.5 or JMath.abs(pitch - look_goal[1]) > 0.5:
    look_goal = [yaw, pitch]
    plan_move(yaw, pitch, True)
    return False
  if look is not None:
    apply_look()
    return False
  return True

def search_widgets(kids, label):
  it = kids.iterator()
  while it.hasNext():
    w = it.next()
    try:
      msg = str(w.getMessage().getString()).lower()
      if label in msg:
        return w
    except Exception:
      pass
    try:
      r = search_widgets(w.children(), label)
      if r is not None:
        return r
    except Exception:
      pass
  return None

def find_button(screen, label):
  try:
    return search_widgets(screen.children(), label)
  except Exception:
    return None

def make_click_event(ev_cls, x, y):
  for c in ev_cls.getConstructors():
    ct = c.getParameterTypes()
    if len(ct) == 3 and str(ct[0].getName()) == "double" and str(ct[1].getName()) == "double":
      for ic in ct[2].getConstructors():
        it = ic.getParameterTypes()
        if len(it) == 2 and str(it[0].getName()) == "int" and str(it[1].getName()) == "int":
          info = ic.newInstance(JavaArray((to_int(0), to_int(0))))
          return c.newInstance(JavaArray((x * 1.0, y * 1.0, info)))
  return None

def named_methods(obj, name, nparams):
  out = []
  for m in obj.getClass().getMethods():
    if str(m.getName()) == name and len(m.getParameterTypes()) == nparams:
      out.append(m)
  return out

def click_event_for(screen, x, y):
  for m in named_methods(screen, "mouseClicked", 2):
    try:
      ev = make_click_event(m.getParameterTypes()[0], x, y)
      if ev is not None:
        return ev
    except Exception:
      pass
  for m in screen.getClass().getMethods():
    pt = m.getParameterTypes()
    if len(pt) == 2 and str(pt[1].getName()) == "boolean" and not pt[0].isPrimitive():
      try:
        ev = make_click_event(pt[0], x, y)
        if ev is not None:
          return ev
      except Exception:
        pass
  return None

def press_attempt(screen, w, attempt):
  x = w.getX() + w.getWidth() / 2.0
  y = w.getY() + w.getHeight() / 2.0
  ev = click_event_for(screen, x, y)
  if attempt == 0 and ev is not None:
    for m in named_methods(screen, "mouseClicked", 2):
      try:
        m.invoke(screen, JavaArray((ev, False)))
      except Exception:
        pass
    for m in named_methods(screen, "mouseReleased", 1):
      try:
        m.invoke(screen, JavaArray((ev,)))
      except Exception:
        pass
    return "screen click + release"
  if attempt == 1:
    for m in named_methods(w, "onPress", 1):
      try:
        if ev is not None and m.getParameterTypes()[0].isInstance(ev):
          m.invoke(w, JavaArray((ev,)))
          return "button onPress"
      except Exception:
        pass
    for m in named_methods(w, "onPress", 0):
      try:
        m.invoke(w, JavaArray(()))
        return "button onPress()"
      except Exception:
        pass
    attempt = 2
  if attempt == 2 and ev is not None:
    for m in named_methods(w, "mouseClicked", 2):
      try:
        m.invoke(w, JavaArray((ev, False)))
      except Exception:
        pass
    for m in named_methods(w, "mouseReleased", 1):
      try:
        m.invoke(w, JavaArray((ev,)))
      except Exception:
        pass
    return "button click + release"
  r = press(screen, w)
  if r is None:
    return "no click method"
  return r

def press(screen, w):
  x = w.getX() + w.getWidth() / 2.0
  y = w.getY() + w.getHeight() / 2.0
  methods = screen.getClass().getMethods()
  for m in methods:
    pt = m.getParameterTypes()
    if len(pt) == 2 and str(pt[1].getName()) == "boolean" and not pt[0].isPrimitive():
      try:
        ev = make_click_event(pt[0], x, y)
      except Exception:
        ev = None
      if ev is not None:
        try:
          m.invoke(screen, JavaArray((ev, False)))
          return "mouse event"
        except Exception:
          pass
  done = False
  for m in methods:
    pt = m.getParameterTypes()
    if (len(pt) == 3 and str(pt[0].getName()) == "double" and str(pt[1].getName()) == "double"
        and str(pt[2].getName()) == "int" and str(m.getReturnType().getName()) == "boolean"):
      try:
        m.invoke(screen, JavaArray((x * 1.0, y * 1.0, to_int(0))))
        done = True
      except Exception:
        pass
  if done:
    return "x/y click"
  try:
    w.onPress()
    return "button press"
  except Exception:
    return None

def stuck_on(d, i):
  if "last" in d and d["last"] == i:
    d["stuck"] = d["stuck"] + 1
  else:
    d["stuck"] = 0
  d["last"] = i
  return d["stuck"] >= 2

def set_selected(i):
  try:
    inv().setSelectedSlot(to_int(i))
    return
  except Exception:
    pass
  try:
    inv().selected = to_int(i)
  except Exception:
    pass

recent_chat = []

chat_field = None

def chat_list():
  global chat_field
  chat = mc.gui.getChat()
  if chat_field is None:
    cls = chat.getClass()
    while cls is not None and chat_field is None:
      for f in cls.getDeclaredFields():
        if str(f.getName()) == "allMessages":
          f.setAccessible(True)
          chat_field = f
          break
      cls = cls.getSuperclass()
    if chat_field is None:
      chat_field = "none"
  if chat_field == "none":
    return None
  return chat_field.get(chat)

def chat_text(gm):
  try:
    return strip_codes(str(gm.content().getString())).lower()
  except Exception:
    try:
      for m in named_methods(gm, "content", 0):
        return strip_codes(str(m.invoke(gm, JavaArray(())).getString())).lower()
    except Exception:
      pass
  return ""

def chat_mark():
  try:
    lst = chat_list()
    if lst is None or lst.size() == 0:
      return 0
    return to_int(System.identityHashCode(lst.get(0)))
  except Exception:
    return 0

def chat_since(t, needles, mark):
  for item in recent_chat:
    if item[0] >= t:
      for n in needles:
        if n in item[1]:
          return item[1]
  if mark is not None:
    try:
      lst = chat_list()
      if lst is not None:
        k = 0
        while k < lst.size() and k < 30:
          gm = lst.get(k)
          if to_int(System.identityHashCode(gm)) == mark:
            break
          txt = chat_text(gm)
          if not txt.startswith("gold:"):
            for n in needles:
              if n in txt:
                return txt
          k = k + 1
    except Exception:
      pass
  return None

def is_chat_screen(scr):
  try:
    return "chat" in str(scr.getClass().getSimpleName()).lower()
  except Exception:
    return False

def is_pause_screen(scr):
  try:
    if "pause" in str(scr.getClass().getSimpleName()).lower():
      return True
    return find_button(scr, "back to game") is not None
  except Exception:
    return False

def close_pause_menu():
  scr = get_screen()
  if scr is None or not is_pause_screen(scr):
    return False
  try:
    mc.setScreen(None)
  except Exception:
    try:
      scr.onClose()
    except Exception:
      pass
  return True

old_pause_setting = None

pause_field = None

def find_pause_field():
  global pause_field
  if pause_field is None:
    opts = mc.options
    cls = opts.getClass()
    while cls is not None and pause_field is None:
      for f in cls.getDeclaredFields():
        if str(f.getName()) == "pauseOnLostFocus":
          f.setAccessible(True)
          pause_field = f
          break
      cls = cls.getSuperclass()
  return pause_field

def disable_pause_on_focus_loss():
  global old_pause_setting
  try:
    f = find_pause_field()
    if f is None:
      return False
    old_pause_setting = f.getBoolean(mc.options)
    f.setBoolean(mc.options, False)
    return True
  except Exception:
    return False

def restore_pause_on_focus_loss():
  if old_pause_setting is None:
    return
  try:
    find_pause_field().setBoolean(mc.options, old_pause_setting)
  except Exception:
    pass

key_use_ref = None

food_warned = False

def key_use():
  global key_use_ref
  if key_use_ref is None:
    try:
      key_use_ref = mc.options.keyUse
    except Exception:
      key_use_ref = find_field(mc.options, "keyUse")
  return key_use_ref

def hold_right_click(down):
  try:
    key_use().setDown(down)
  except Exception:
    pass

def food_level():
  try:
    return to_int(mc.player.getFoodData().getFoodLevel())
  except Exception:
    return 20

def st_eat(d):
  global food_warned
  ph = d["phase"]
  slot = to_int(FOOD_SLOT - 1)
  if ph == 0:
    if food_level() > EAT_BELOW:
      return True
    food = inv_stack(slot)
    if food.isEmpty():
      if not food_warned:
        food_warned = True
        say("hungry, but hotbar slot " + str(FOOD_SLOT) + " is empty - put food there")
      return True
    close_all()
    d["sel"] = selected_slot()
    d["name"] = item_name(food)
    d["yaw"] = mc.player.getYRot() + (rnd() - 0.5) * 20.0
    d["pitch"] = -70.0 - rnd() * 15.0
    d["phase"] = 1
    say("hungry (" + str(food_level()) + "/20) - eating " + d["name"].replace("_", " "))
    return False
  if ph == 1:
    if not ease_look(d["yaw"], d["pitch"]):
      return False
    set_selected(slot)
    d["phase"] = 2
    wait(hdelay(4, 8))
    return False
  if ph == 2:
    d["food0"] = food_level()
    d["count0"] = inv_stack(slot).getCount()
    d["t0"] = tick_count
    hold_right_click(True)
    d["phase"] = 3
    return False
  if ph == 3:
    done = food_level() > d["food0"] or inv_stack(slot).getCount() < d["count0"] or inv_stack(slot).isEmpty()
    if done or tick_count - d["t0"] > 60:
      hold_right_click(False)
      if not done:
        say("couldn't eat (is it food?)")
      d["phase"] = 4
      wait(hdelay(4, 10))
    return False
  if food_level() <= EAT_BELOW and not inv_stack(slot).isEmpty() and "again" not in d:
    d["again"] = True
    d["phase"] = 2
    return False
  set_selected(d["sel"])
  wait(hdelay(4, 10))
  return True

def other_run_alive():
  prev = System.getProperty(RUN_KEY)
  if prev is None or str(prev) == "":
    return False
  beat = System.getProperty(BEAT_KEY)
  if beat is None or str(beat) == "":
    return False
  return System.currentTimeMillis() - JDouble.valueOf(str(beat)) < 2000

DC = None

def clip(s, a, b):
  s = str(s)
  n = len(s)
  if a < 0:
    a = 0
  if b > n:
    b = n
  if a >= b:
    return ""
  return s[a:b]

def last_find(s, sub):
  pos = -1
  start = 0
  going = True
  while going:
    i = s[start:].find(sub)
    if i < 0:
      going = False
    else:
      pos = start + i
      start = pos + 1
      if start >= len(s):
        going = False
  return pos

def parse_money(s):
  t = str(s).lower().replace("$", "").replace(",", "")
  num = ""
  started = False
  i = 0
  while i < len(t):
    ch = t[i]
    if ch in "0123456789" or (ch == "." and started):
      num = num + ch
      started = True
    elif started:
      break
    i = i + 1
  if num == "" or num == ".":
    return None
  v = JDouble.parseDouble(num)
  while i < len(t) and t[i] == " ":
    i = i + 1
  if i < len(t):
    if t[i] == "k":
      v = v * 1000.0
    elif t[i] == "m":
      v = v * 1000000.0
    elif t[i] == "b":
      v = v * 1000000000.0
  return v

def trim_num(x):
  s = str(JMath.round(x * 100.0) / 100.0)
  if s.endswith(".0"):
    s = s[:len(s) - 2]
  return s

def fmt_price(v):
  if v >= 1000000:
    return trim_num(v / 1000000.0) + "m"
  if v >= 1000:
    return trim_num(v / 1000.0) + "k"
  return str(to_int(v))

def display_step(v):
  if v < 1000:
    return 1.0
  if v < 1000000:
    return 100.0
  return 100000.0

def clean_price(v):
  st = display_step(v)
  c = JMath.ceil(v / st) * st
  if c < 1000 and v >= 1000:
    c = 1000.0
  return c

def outbid(top):
  if top < 1000:
    return JMath.floor(top) + 1.0
  if top < 1000000:
    return (JMath.floor(top / 100.0) + 1.0) * 100.0
  return (JMath.floor(top / 10000.0) + 1.0) * 10000.0

def lore_lines(stack):
  global DC
  out = []
  if stack is None or stack.isEmpty():
    return out
  try:
    if DC is None:
      DC = JavaClass("net.minecraft.core.component.DataComponents")
    lore = stack.get(DC.LORE)
    if lore is not None:
      it = lore.lines().iterator()
      while it.hasNext():
        out.append(str(it.next().getString()).lower())
      return out
  except Exception:
    pass
  try:
    out.append(str(stack.getComponents()).lower())
  except Exception:
    pass
  return out

def lore_has(stack, text):
  for ln in lore_lines(stack):
    if text in ln:
      return True
  return False

def parse_order(stack):
  o = {"id": item_name(stack), "requested": 0.0, "delivered": 0.0, "price": 0.0, "completed": False}
  for ln in lore_lines(stack):
    if "requested" in ln:
      v = parse_money(ln)
      if v is not None:
        o["requested"] = v
    if "delivered" in ln and "/" in ln:
      parts = ln.split("/")
      a = parse_money(parts[0])
      b = parse_money(parts[1])
      if a is not None:
        o["delivered"] = a
      if b is not None and o["requested"] == 0.0:
        o["requested"] = b
    if "each" in ln:
      v = parse_money(ln)
      if v is not None:
        o["price"] = v
    if "completed" in ln:
      o["completed"] = True
  if o["requested"] > 0 and o["delivered"] >= o["requested"]:
    o["completed"] = True
  return o

def order_key(o, slot):
  return o["id"] + "|" + str(to_int(o["requested"])) + "|" + str(to_int(o["price"])) + "|" + str(slot)

scr_kind_cache = {}

btn_class_cache = {}

def is_container_screen(scr):
  k = str(scr.getClass().getName())
  if k not in scr_kind_cache:
    scr_kind_cache[k] = len(named_methods(scr, "getMenu", 0)) > 0
  return scr_kind_cache[k]

def container_open():
  scr = get_screen()
  if scr is None or not is_container_screen(scr):
    return None
  m = cur_menu()
  if menu_id(m) == 0:
    return None
  return m

def is_dialog(scr):
  if scr is None or is_container_screen(scr):
    return False
  if is_chat_screen(scr) or is_pause_screen(scr):
    return False
  return True

def walk_widgets(kids, out):
  it = kids.iterator()
  while it.hasNext():
    w = it.next()
    out.append(w)
    try:
      walk_widgets(w.children(), out)
    except Exception:
      pass

def widgets_of(scr):
  out = []
  try:
    walk_widgets(scr.children(), out)
  except Exception:
    pass
  return out

def wtext(w):
  try:
    return str(w.getMessage().getString())
  except Exception:
    return ""

def is_button(w):
  k = "b:" + str(w.getClass().getName())
  if k not in btn_class_cache:
    btn_class_cache[k] = len(named_methods(w, "onPress", 1)) + len(named_methods(w, "onPress", 0)) > 0
  return btn_class_cache[k]

def is_editbox(w):
  k = "e:" + str(w.getClass().getName())
  if k not in btn_class_cache:
    btn_class_cache[k] = len(named_methods(w, "setValue", 1)) > 0 and len(named_methods(w, "getValue", 0)) > 0
  return btn_class_cache[k]

def words(s):
  out = []
  cur = ""
  for ch in str(s).lower():
    if ch in "abcdefghijklmnopqrstuvwxyz0123456789":
      cur = cur + ch
    else:
      if cur != "":
        out.append(cur)
      cur = ""
  if cur != "":
    out.append(cur)
  return out

def find_btn(scr, label):
  want = " ".join(words(label))
  for w in widgets_of(scr):
    if is_button(w) and " ".join(words(wtext(w))) == want:
      return w
  return None

def has_run(ws, want):
  n = len(want)
  k = 0
  while k + n <= len(ws):
    ok = True
    j = 0
    while j < n:
      if ws[k + j] != want[j]:
        ok = False
      j = j + 1
    if ok:
      return True
    k = k + 1
  return False

def find_editbox(scr):
  for w in widgets_of(scr):
    if is_editbox(w):
      return w
  return None

def screen_text(scr):
  parts = []
  for w in widgets_of(scr):
    t = wtext(w)
    if t != "":
      parts.append(t.lower())
  return " | ".join(parts)

def dialog_report(scr):
  if scr is None:
    return "No screen open"
  if not is_dialog(scr):
    return "Open screen isn't a popup: " + str(scr.getClass().getSimpleName()) + " '" + screen_title() + "'"
  eb = find_editbox(scr)
  box = "none"
  if eb is not None:
    try:
      box = "'" + str(eb.getValue()) + "'"
    except Exception:
      box = "?"
  btns = []
  n = 0
  for w in widgets_of(scr):
    if is_button(w):
      n = n + 1
      if len(btns) < 8:
        btns.append(wtext(w))
  return ("Screen '" + screen_title() + "', search box " + box + ", " + str(n) + " buttons: "
          + clip(", ".join(btns), 0, 160))

def press_btn(scr, w):
  return press_attempt(scr, w, 1)

def handle_warning(scr):
  if scr is None:
    return False
  if find_btn(scr, "disconnect") is not None:
    b = find_btn(scr, "back")
    if b is not None:
      press_btn(scr, b)
      say("closed Minecraft's 'custom screens' note")
      return True
  return False

def slot_named(m, text):
  for i in range(container_size(m)):
    s = slot_stack(m, i)
    if not s.isEmpty() and hover(s).strip() == text:
      return i
  return -1

def is_your_orders(m):
  if slot_named(m, "new order") >= 0:
    return True
  top = container_size(m)
  if top > 45:
    top = 45
  for i in range(top):
    if lore_has(slot_stack(m, i), "requested"):
      return True
  return False

def open_orders(d):
  close_all()
  send_cmd(ORDERS_CMD)
  d["t0"] = tick_count
  wait(hdelay(4, 8))

def timed_out(d, ticks):
  if reclick_if_missed():
    d["t0"] = tick_count
    return False
  return tick_count - d["t0"] > ticks

def stacks_of(name):
  out = []
  for i in range(36):
    s = inv_stack(i)
    if not s.isEmpty() and item_name(s) == name:
      out.append([s.getCount(), i])
  k = 0
  while k < len(out):
    j = k + 1
    while j < len(out):
      if out[j][0] > out[k][0]:
        t = out[k]
        out[k] = out[j]
        out[j] = t
      j = j + 1
    k = k + 1
  return out

def total_of(name):
  n = 0
  for st in stacks_of(name):
    n = n + st[0]
  return n

JFile = JavaClass("java.io.File")

def fmt_money(v):
  if v < 0:
    return "§c-$" + fmt_price(-v) + "§r"
  return "$" + fmt_price(v)

def num_str(v):
  r = JMath.round(v * 1.0)
  if JMath.abs(v - r) < 0.000001:
    return str(r)
  return str(v)

def book_dir():
  return JFile(mc.gameDirectory, "minescript")

def forget_done(item_id):
  ks = []
  for k in done_orders:
    if k.startswith(item_id + "|"):
      ks.append(k)
  for k in ks:
    del done_orders[k]

def chat_lines_since(mark):
  out = []
  try:
    lst = chat_list()
    if lst is None:
      return out
    k = 0
    while k < lst.size() and k < 30:
      gm = lst.get(k)
      if to_int(System.identityHashCode(gm)) == mark:
        break
      t = chat_text(gm)
      if not t.startswith("gold:"):
        out.append(t)
      k = k + 1
  except Exception:
    pass
  return out

def st_read_top(d):
  key = d["key"]
  name = ITEMS[key]["name"]
  ph = d["phase"]
  if ph == 0:
    top_price[key] = None
    open_orders(d)
    d["phase"] = 1
    return False
  if ph == 1:
    m = container_open()
    if m is not None and slot_named(m, "your orders") >= 0:
      i = slot_named(m, "search")
      if i < 0:
        say("can't find the Search button in /orders")
        close_all()
        return True
      d["prev"] = menu_id(m)
      click(m, i, 0, 0)
      d["phase"] = 2
      d["t0"] = tick_count
      wait(hdelay(5, 10))
      return False
    if timed_out(d, 130):
      say("/orders didn't open")
      return True
    return False
  if ph == 2:
    scr = get_screen()
    if is_dialog(scr):
      if handle_warning(scr):
        wait(10)
        return False
      eb = find_editbox(scr)
      if eb is not None and find_btn(scr, "search") is not None:
        eb.setValue(ITEMS[key]["search"])
        d["phase"] = 3
        wait(hdelay(4, 9))
        return False
    if timed_out(d, 100):
      say("the Search Orders box didn't open (screen: '" + screen_title() + "')")
      close_all()
      return True
    return False
  if ph == 3:
    scr = get_screen()
    b = None
    if is_dialog(scr):
      b = find_btn(scr, "search")
    if b is None:
      d["phase"] = 2
      return False
    press_btn(scr, b)
    d["phase"] = 4
    d["t0"] = tick_count
    d["seen"] = -1
    d["page"] = 1
    d["prev_title"] = "@"
    d["prev_sig"] = "@"
    wait(hdelay(6, 10))
    return False
  m = container_open()
  if m is not None and (menu_id(m) != d["prev"] or screen_title() != d["prev_title"] or page_sig(m) != d["prev_sig"]):
    if d["seen"] < 0:
      d["seen"] = tick_count
      return False
    if tick_count - d["seen"] < 6:
      return False
    if "best" not in d:
      d["best"] = None
      d["best_page"] = 0
      d["n"] = 0
      d["seen_prices"] = []
      d["book"] = []
      d["covered"] = 0.0
    top = container_size(m)
    if top > 45:
      top = 45
    page_had = False
    for i in range(top):
      s = slot_stack(m, i)
      if s.isEmpty() or item_name(s) != ITEMS[key]["id"]:
        continue
      page_had = True
      if dget(d, "depth", 0) > 0:
        o = parse_order(s)
        left = o["requested"] - o["delivered"]
        if o["price"] > 0 and left > 0 and not o["completed"]:
          d["book"].append([o["price"], left])
          d["covered"] = d["covered"] + left
      for ln in lore_lines(s):
        if "each" in ln:
          v = parse_money(ln)
          if v is not None:
            d["n"] = d["n"] + 1
            if len(d["seen_prices"]) < 3:
              d["seen_prices"].append(fmt_money(v) + " (slot " + str(i + 1) + ")")
            if d["best"] is None or v > d["best"]:
              d["best"] = v
              d["best_page"] = d["page"]
    if dget(d, "depth", 0) > 0:
      if page_had:
        d["had_item"] = True
      if d["covered"] >= d["depth"] or (dget(d, "had_item", False) and not page_had):
        return finish_read_top(d, key, name)
    elif d["best"] is not None:
      return finish_read_top(d, key, name)
    nx = slot_named(m, "next page")
    if nx >= 0 and d["page"] < MAX_SEARCH_PAGES:
      d["page"] = d["page"] + 1
      d["prev"] = menu_id(m)
      d["prev_title"] = screen_title()
      d["prev_sig"] = page_sig(m)
      d["seen"] = -1
      d["t0"] = tick_count
      click(m, nx, 0, 0)
      wait(hdelay(3, 6))
      return False
    return finish_read_top(d, key, name)
  if "best" in d and timed_out(d, 60):
    return finish_read_top(d, key, name)
  if timed_out(d, 130):
    say("the " + name + " search didn't show any results")
    close_all()
    return True
  return False

def dget(d, k, default):
  if k in d:
    return d[k]
  return default

def page_sig(m):
  parts = []
  top = container_size(m)
  if top > 45:
    top = 45
  for i in range(top):
    parts.append(item_name(slot_stack(m, i)))
  for i in [0, top - 1]:
    if i >= 0:
      for ln in lore_lines(slot_stack(m, i)):
        if "each" in ln or "delivered" in ln:
          parts.append(ln)
  return "|".join(parts)

def value_after(text, key):
  i = text.find(key)
  if i < 0:
    return None
  return parse_money(clip(text, i + len(key), i + len(key) + 30))

def st_create(d):
  global expect_orders
  key = d["key"]
  name = ITEMS[key]["name"]
  ph = d["phase"]
  if ph == 0:
    open_orders(d)
    d["phase"] = 1
    return False
  if ph == 1:
    m = container_open()
    if m is not None and slot_named(m, "your orders") >= 0:
      d["prev"] = menu_id(m)
      click(m, slot_named(m, "your orders"), 0, 0)
      d["phase"] = 2
      d["t0"] = tick_count
      wait(hdelay(5, 10))
      return False
    if timed_out(d, 130):
      return fail_stop("/orders didn't open")
    return False
  if ph == 2:
    m = container_open()
    if m is not None and menu_id(m) != d["prev"] and is_your_orders(m):
      i = slot_named(m, "new order")
      if i < 0:
        return fail_stop("no free order slot in Your Orders")
      click(m, i, 0, 0)
      d["phase"] = 3
      d["t0"] = tick_count
      wait(hdelay(5, 10))
      return False
    if timed_out(d, 100):
      return fail_stop("Your Orders didn't open")
    return False
  if ph == 3:
    scr = get_screen()
    if is_dialog(scr):
      if handle_warning(scr):
        wait(10)
        return False
      eb = find_editbox(scr)
      if eb is not None and find_btn(scr, "search") is not None:
        eb.setValue(ITEMS[key]["search"])
        d["phase"] = 4
        wait(hdelay(4, 9))
        return False
    m = container_open()
    if m is not None and is_your_orders(m) and tick_count - d["t0"] > 40 and dget(d, "new_tries", 0) < 3:
      i = slot_named(m, "new order")
      if i >= 0:
        d["new_tries"] = dget(d, "new_tries", 0) + 1
        say("New Order click didn't go through - clicking again (" + str(d["new_tries"]) + "/3)")
        click(m, i, 0, 0)
        d["t0"] = tick_count
        wait(hdelay(5, 10))
        return False
    if timed_out(d, 100):
      return fail_stop("the Choose Item screen didn't open (screen: '" + screen_title() + "')")
    return False
  if ph == 4:
    scr = get_screen()
    b = None
    if is_dialog(scr):
      b = find_btn(scr, "search")
    if b is None:
      d["phase"] = 3
      return False
    d["old_scr"] = System.identityHashCode(scr)
    press_btn(scr, b)
    d["phase"] = 5
    d["t0"] = tick_count
    wait(hdelay(6, 10))
    return False
  if ph == 5:
    scr = get_screen()
    if scr is not None and System.identityHashCode(scr) == d["old_scr"]:
      if timed_out(d, 100):
        d["old_scr"] = -1
      return False
    if is_dialog(scr):
      b = find_item_btn(scr, key)
      if b is not None:
        say("picking '" + clip(wtext(b), 0, 40) + "' (" + clip(screen_title(), 0, 40) + ")")
        press_btn(scr, b)
        d["phase"] = 6
        d["t0"] = tick_count
        wait(hdelay(6, 10))
        return False
    if timed_out(d, 100):
      if "retried" not in d:
        d["retried"] = True
        say("didn't see '" + name + "' after searching - searching again")
        d["phase"] = 3
        d["t0"] = tick_count
        return False
      return fail_stop("couldn't find '" + name + "' in Choose Item. " + dialog_report(scr))
    return False
  if ph == 6:
    scr = get_screen()
    if is_dialog(scr) and find_btn(scr, "next") is not None:
      eb = find_editbox(scr)
      if eb is not None:
        eb.setValue(str(to_int(d["amount"])))
        d["phase"] = 7
        wait(hdelay(4, 9))
        return False
    if timed_out(d, 100):
      return fail_stop("the 'How many?' screen didn't open")
    return False
  if ph == 7:
    scr = get_screen()
    b = None
    if is_dialog(scr):
      b = find_btn(scr, "next")
    if b is None:
      d["phase"] = 6
      return False
    press_btn(scr, b)
    d["phase"] = 8
    d["t0"] = tick_count
    wait(hdelay(6, 10))
    return False
  if ph == 8:
    scr = get_screen()
    if is_dialog(scr) and find_btn(scr, "review order") is not None:
      eb = find_editbox(scr)
      if eb is not None:
        eb.setValue(fmt_price(d["price"]))
        d["phase"] = 9
        wait(hdelay(4, 9))
        return False
    if timed_out(d, 100):
      return fail_stop("the 'Price per item?' screen didn't open")
    return False
  if ph == 9:
    scr = get_screen()
    b = None
    if is_dialog(scr):
      b = find_btn(scr, "review order")
    if b is None:
      d["phase"] = 8
      return False
    press_btn(scr, b)
    d["phase"] = 10
    d["t0"] = tick_count
    wait(hdelay(6, 10))
    return False
  if ph == 10:
    scr = get_screen()
    if is_dialog(scr) and find_btn(scr, "create order") is not None:
      problem = check_review(screen_text(scr), d)
      if problem is not None and problem.startswith("can't read") and not AUTO_CREATE:
        say("TEST MODE: I can't read the Review Order screen (" + clip(problem, 0, 60) + ") - check it yourself: "
            + str(to_int(d["amount"])) + " " + name + " at $" + fmt_price(d["price"]) + " each. Click Create Order or Cancel")
        d["phase"] = 12
        return False
      if problem is not None:
        b = find_btn(scr, "cancel")
        if b is not None:
          press_btn(scr, b)
        return fail_stop("Review Order looks wrong (" + problem + "), cancelled it")
      if AUTO_CREATE:
        d["mark"] = chat_mark()
        d["sent_tick"] = tick_count
        press_btn(scr, find_btn(scr, "create order"))
        expect_orders = True
        record_order(key, d["amount"], d["price"], dget(d, "rebid", False))
        forget_done(ITEMS[key]["id"])
        say("created order: " + str(to_int(d["amount"])) + " " + name + " at $" + fmt_price(d["price"]) + " each")
        d["phase"] = 11
        d["t0"] = tick_count
        wait(hdelay(10, 16))
        return False
      say("TEST MODE: the " + name + " order is filled in and checked. Look at Review Order and click Create Order yourself (or Cancel)")
      d["phase"] = 12
      return False
    if timed_out(d, 100):
      return fail_stop("the Review Order screen didn't open")
    return False
  if ph == 12:
    scr = get_screen()
    if is_dialog(scr) and find_btn(scr, "create order") is not None:
      return False
    expect_orders = True
    record_order(key, d["amount"], d["price"], dget(d, "rebid", False))
    forget_done(ITEMS[key]["id"])
    wait(hdelay(10, 16))
    return True
  reply = chat_since(d["sent_tick"], [""], d["mark"])
  if reply is not None:
    say("server: " + reply)
    close_all()
    return True
  if timed_out(d, 40):
    close_all()
    return True
  return False

def find_my_order(m, item_id, price):
  top = container_size(m)
  if top > 45:
    top = 45
  for i in range(top):
    st = slot_stack(m, i)
    if st.isEmpty() or item_name(st) != item_id or not lore_has(st, "requested"):
      continue
    o = parse_order(st)
    if not o["completed"] and JMath.abs(o["price"] - price) <= price * 0.02 + 1:
      return i
  return -1

def free_slots():
  n = 0
  for i in range(36):
    if inv_stack(i).isEmpty():
      n = n + 1
  return n

def st_rebid(d):
  ph = d["phase"]
  item_id = d["id"]
  name = ITEMS[d["key"]]["name"]
  if ph == 0 or ph == 7:
    open_orders(d)
    d["phase"] = ph + 1
    return False
  if ph == 1 or ph == 8:
    m = container_open()
    if m is not None and slot_named(m, "your orders") >= 0:
      d["prev"] = menu_id(m)
      click(m, slot_named(m, "your orders"), 0, 0)
      d["phase"] = ph + 1
      d["t0"] = tick_count
      wait(hdelay(5, 10))
      return False
    if timed_out(d, 130):
      say("re-bid stopped: /orders didn't open")
      close_all()
      return True
    return False
  if ph == 2 or ph == 9:
    m = container_open()
    if m is None or menu_id(m) == d["prev"] or not is_your_orders(m):
      if timed_out(d, 100):
        say("re-bid stopped: Your Orders didn't open")
        close_all()
        return True
      return False
    if "loaded" not in d:
      d["loaded"] = tick_count
      return False
    if tick_count - d["loaded"] < 5:
      return False
    del d["loaded"]
    i = find_my_order(m, item_id, d["old_price"])
    if ph == 9:
      close_all()
      if i >= 0:
        say("re-bid stopped: the old " + name + " order is still there (the cancel didn't go through)")
        return True
      say("old " + name + " order cancelled - ordering the " + str(to_int(d["left"])) + " still missing at "
          + fmt_money(d["new_price"]))
      steps.insert(1, [st_create, {"phase": 0, "key": d["key"], "amount": to_int(d["left"]), "price": d["new_price"],
                                   "rebid": True}])
      wait(hdelay(6, 12))
      return True
    if i < 0:
      say("re-bid stopped: can't find your " + name + " order at " + fmt_money(d["old_price"]))
      close_all()
      return True
    o = parse_order(slot_stack(m, i))
    d["left"] = o["requested"] - o["delivered"]
    if d["left"] < 1:
      say("re-bid not needed: the " + name + " order just filled")
      close_all()
      return True
    d["prev"] = menu_id(m)
    click(m, i, 0, 0)
    d["phase"] = 3
    d["t0"] = tick_count
    wait(hdelay(5, 10))
    return False
  if ph == 3:
    m = container_open()
    if m is None or menu_id(m) == d["prev"] or slot_named(m, "cancel") < 0:
      if timed_out(d, 100):
        say("re-bid stopped: Edit Order didn't open")
        close_all()
        return True
      return False
    ci = slot_named(m, "collect")
    pending = 0.0
    if ci >= 0:
      for ln in lore_lines(slot_stack(m, ci)):
        j = last_find(ln, " x")
        if j >= 0:
          v = parse_money(clip(ln, j + 2, j + 20))
          if v is not None:
            pending = pending + v
    if pending > 0:
      if (pending + 63) / 64 > free_slots() - 1:
        say("re-bid waits: " + str(to_int(pending)) + " delivered " + name + " to collect first and not enough room")
        close_all()
        return True
      d["prev"] = menu_id(m)
      click(m, ci, 0, 0)
      d["phase"] = 4
      d["t0"] = tick_count
      wait(hdelay(5, 10))
      return False
    d["prev"] = menu_id(m)
    d["mark"] = chat_mark()
    click(m, slot_named(m, "cancel"), 0, 0)
    d["phase"] = 5
    d["t0"] = tick_count
    wait(hdelay(5, 10))
    return False
  if ph == 4:
    m = container_open()
    if m is None or menu_id(m) == d["prev"] or slot_named(m, "cancel") >= 0:
      if m is not None and slot_named(m, "collect") >= 0 and slot_named(m, "cancel") >= 0 and tick_count - d["t0"] > 40 and dget(d, "col_tries", 0) < 3:
        d["col_tries"] = dget(d, "col_tries", 0) + 1
        say("Collect click didn't go through - clicking again (" + str(d["col_tries"]) + "/3)")
        d["prev"] = menu_id(m)
        click(m, slot_named(m, "collect"), 0, 0)
        d["t0"] = tick_count
        wait(hdelay(5, 10))
        return False
      if timed_out(d, 100):
        say("re-bid stopped: Collect Items didn't open")
        close_all()
        return True
      return False
    for i in range(container_size(m)):
      st = slot_stack(m, i)
      if not st.isEmpty() and item_name(st) == item_id:
        if stuck_on(d, i):
          break
        click(m, i, 0, 1)
        wait(hdelay(2, 5))
        return False
    close_all()
    d["phase"] = 0
    wait(hdelay(5, 9))
    return False
  if ph == 5:
    m = container_open()
    if m is not None and "cancel" in screen_title():
      i = confirm_slot(m)
      if i < 0:
        say("re-bid stopped: no Confirm button on Cancel Order")
        close_all()
        return True
      click(m, i, 0, 0)
      d["phase"] = 6
      d["t0"] = tick_count
      wait(hdelay(10, 16))
      return False
    if m is not None and slot_named(m, "cancel") >= 0 and "cancel" not in screen_title() and tick_count - d["t0"] > 40 and dget(d, "can_tries", 0) < 3:
      d["can_tries"] = dget(d, "can_tries", 0) + 1
      say("Cancel click didn't go through - clicking again (" + str(d["can_tries"]) + "/3)")
      click(m, slot_named(m, "cancel"), 0, 0)
      d["t0"] = tick_count
      wait(hdelay(5, 10))
      return False
    if timed_out(d, 100):
      say("re-bid stopped: Cancel Order didn't open")
      close_all()
      return True
    return False
  if ph == 6:
    for ln in chat_lines_since(d["mark"]):
      if "$" in ln and ("refund" in ln or "cancel" in ln):
        say("server: " + clip(ln, 0, 80))
        break
    close_all()
    d["phase"] = 7
    wait(hdelay(6, 10))
    return False
  return True

def read_balance():
  try:
    sb = mc.level.getScoreboard()
    DS = JavaClass("net.minecraft.world.scores.DisplaySlot")
    obj = sb.getDisplayObjective(DS.SIDEBAR)
    if obj is None:
      return None
    it = sb.listPlayerScores(obj).iterator()
    while it.hasNext():
      e = it.next()
      txt = ""
      try:
        txt = str(e.owner())
        team = sb.getPlayersTeam(e.owner())
        if team is not None:
          txt = str(team.getPlayerPrefix().getString()) + txt + str(team.getPlayerSuffix().getString())
      except Exception:
        pass
      try:
        dsp = e.display()
        if dsp is not None:
          txt = txt + " " + str(dsp.getString())
      except Exception:
        pass
      txt = strip_codes(txt).lower()
      i = txt.find("$")
      if i >= 0:
        v = parse_money(clip(txt, i, i + 20))
        if v is not None:
          return v
  except Exception:
    return None
  return None

def confirm_slot(m):
  i = slot_named(m, "confirm")
  if i >= 0:
    return i
  for k in range(container_size(m)):
    st = slot_stack(m, k)
    if st.isEmpty():
      continue
    n = item_name(st)
    if n == "lime_stained_glass_pane" or n == "green_stained_glass_pane" or n == "lime_concrete" or n == "green_concrete":
      return k
  return -1

SELL = []

def list_file():
  return JFile(book_dir(), LIST_FILE)

def tok(v):
  if v is None:
    return "-"
  if v == "auto":
    return "auto"
  return num_str(v)

def untok(t):
  t = str(t).strip().lower()
  if t == "-" or t == "" or t == "none" or t == "all":
    return None
  if t == "auto":
    return "auto"
  return parse_money(t)

MATERIAL_BLOCKS = ["gold", "iron", "diamond", "emerald", "netherite", "copper", "redstone", "coal", "quartz", "amethyst",
                   "raw_gold", "raw_iron", "raw_copper"]

def default_label(item):
  if item.endswith("_block"):
    base = clip(item, 0, len(item) - 6)
    if base in MATERIAL_BLOCKS:
      return "block of " + base.replace("_", " ")
  return item.replace("_", " ")

def label_of(c):
  if "label" in c and c["label"] is not None:
    return c["label"]
  return default_label(c["item"])

def load_list():
  global SELL, UNDERCUT, OUTLIER_PCT, REPRICE, CHECK_MIN, SPEED, MIN_PROFIT_PCT, WAR_PCT, AH_DROP_PCT, BID_EXTRA_PCT
  global RESCAN_MIN, MM_MODE, PICK_BY, SELL_SPEED_PCT
  out = []
  f = list_file()
  if not f.exists():
    SELL = out
    return
  lines = JavaClass("java.nio.file.Files").readAllLines(f.toPath())
  k = 0
  while k < lines.size():
    raw = str(lines.get(k)).strip()
    k = k + 1
    if raw == "" or raw.startswith("item,"):
      continue
    parts = []
    for x in raw.split(","):
      parts.append(str(x).strip())
    if parts[0] == "#set" and len(parts) >= 3:
      v = untok(parts[2])
      if parts[1] == "undercut" and v is not None:
        UNDERCUT = v
      elif parts[1] == "outlier" and v is not None:
        OUTLIER_PCT = v
      elif parts[1] == "reprice":
        REPRICE = parts[2] == "on"
      elif parts[1] == "check" and v is not None:
        CHECK_MIN = v
      elif parts[1] == "speed" and v is not None:
        SPEED = v
      elif parts[1] == "sellspeed" and v is not None:
        SELL_SPEED_PCT = v
      elif parts[1] == "margin" and v is not None:
        MIN_PROFIT_PCT = v
      elif parts[1] == "war" and v is not None:
        WAR_PCT = v
      elif parts[1] == "drop" and v is not None:
        AH_DROP_PCT = v
      elif parts[1] == "bid" and v is not None:
        BID_EXTRA_PCT = v
      elif parts[1] == "rescan" and v is not None:
        RESCAN_MIN = v
      elif parts[1] == "pick" and parts[2] in ["profit", "percent"]:
        PICK_BY = parts[2]
      elif parts[1] == "mode" and parts[2] in ["ask", "auto"]:
        MM_MODE = parts[2]
      continue
    if len(parts) < 6:
      continue
    per = untok(parts[2])
    if per is None:
      per = 1
    price = untok(parts[3])
    if price is None:
      price = "auto"
    margin = None
    maxbuy = None
    label = None
    if len(parts) > 6:
      margin = untok(parts[6])
    if len(parts) > 7:
      maxbuy = untok(parts[7])
    if len(parts) > 8 and parts[8] != "-" and parts[8] != "":
      label = parts[8]
    on = True
    if len(parts) > 9 and parts[9] == "off":
      on = False
    out.append({"item": parts[0], "total": untok(parts[1]), "per_listing": to_int(per), "price": price,
                "min": untok(parts[4]), "max": untok(parts[5]), "margin": margin, "maxbuy": maxbuy, "label": label, "on": on})
  SELL = out

def save_list():
  W = JavaClass("java.io.FileWriter")
  w = W(list_file(), False)
  w.write("item,amount,per_listing,price,min,max,margin,maxbuy,label,on\n")
  for c in SELL:
    lab = "-"
    if "label" in c and c["label"] is not None:
      lab = c["label"]
    w.write(c["item"] + "," + tok(c["total"]) + "," + str(c["per_listing"]) + "," + tok(c["price"]) + ","
            + tok(c["min"]) + "," + tok(c["max"]) + "," + tok(c["margin"]) + "," + tok(c["maxbuy"]) + "," + lab + "," + on_tok(c) + "\n")
  w.write("#set,undercut," + num_str(UNDERCUT) + "\n")
  w.write("#set,outlier," + num_str(OUTLIER_PCT) + "\n")
  rp = "off"
  if REPRICE:
    rp = "on"
  w.write("#set,reprice," + rp + "\n")
  w.write("#set,check," + num_str(CHECK_MIN) + "\n")
  w.write("#set,speed," + num_str(SPEED) + "\n")
  w.write("#set,sellspeed," + num_str(SELL_SPEED_PCT) + "\n")
  w.write("#set,margin," + num_str(MIN_PROFIT_PCT) + "\n")
  w.write("#set,war," + num_str(WAR_PCT) + "\n")
  w.write("#set,drop," + num_str(AH_DROP_PCT) + "\n")
  w.write("#set,bid," + num_str(BID_EXTRA_PCT) + "\n")
  w.write("#set,rescan," + num_str(RESCAN_MIN) + "\n")
  w.write("#set,mode," + MM_MODE + "\n")
  w.write("#set,pick," + PICK_BY + "\n")
  w.close()

def is_on(c):
  return "on" not in c or c["on"]

def on_tok(c):
  if is_on(c):
    return "on"
  return "off"

def active_list():
  out = []
  for c in SELL:
    if is_on(c):
      out.append(c)
  return out

def margin_of(c):
  if c["margin"] is not None:
    return c["margin"]
  return MIN_PROFIT_PCT

def describe(c):
  amount = "?"
  if c["total"] is not None:
    amount = str(to_int(c["total"]))
  price = "match the cheapest listing"
  if not FOLLOW_ONLY:
    price = "just under the cheapest listing"
  if c["price"] != "auto":
    price = fmt_money(c["price"]) + " each (fixed)"
  lim = ""
  if c["price"] == "auto":
    if c["min"] is not None:
      lim = lim + ", never below " + fmt_money(c["min"])
    if c["max"] is not None:
      lim = lim + ", never above " + fmt_money(c["max"])
  buy = ", buy at " + trim_num(margin_of(c)) + "%+ profit"
  if c["maxbuy"] is not None:
    buy = buy + ", bid at most " + fmt_money(c["maxbuy"])
  return (c["item"] + " ('" + label_of(c) + "'): buys " + amount + ", " + str(c["per_listing"]) + " per listing, sell: "
          + price + lim + buy)

def show_list():
  if len(SELL) == 0:
    say("the trade list is empty - add something: \\marketmaker add end_crystal 64")
    return
  say("trade list:")
  for c in SELL:
    say("  " + describe(c))
  rp = "off"
  if REPRICE:
    rp = "on"
  say("  mode " + MM_MODE.upper() + ", rough check: bid +" + num_str(WAR_PCT) + "%, auction -" + num_str(AH_DROP_PCT)
      + "%, spread re-check every " + num_str(RESCAN_MIN) + " min, re-pricing " + rp
      + ", auction price check every " + num_str(CHECK_MIN) + " min")

def show_help():
  for ln in ["commands (all start with \\marketmaker):",
             "  (nothing) - open the menu (Start trading there) / stop      go - start trading straight away, no menu",
             "  scan [item]   - only look at the spread: what buyers pay, what the auction asks, the profit - buys nothing",
             "  add <item> <buy amount> [per listing] [auto|price] [min] [max] [margin %] [max bid]",
             "     e.g.  add end_crystal 64   |   add diamond 256 64 auto 8k - 3 12k",
             "  set <item> <amount|per|price|min|max|margin|maxbid|label> <value>   e.g. set diamond margin 5",
             "  remove <item|all>    list    help    stop",
             "  mode ask|auto   pick profit|percent   margin <%>   war <%>   drop <%>   bid <%>   rescan <min>",
             "  undercut <$>   outlier <%>   reprice on|off   check <minutes>   speed <1-2>",
             "  prices like 59000, 59k, 1.2m;  '-' = no limit"]:
    say(ln)

def item_arg(a):
  a = str(a).lower()
  if a.startswith("minecraft:"):
    a = clip(a, 10, len(a))
  return a

def run_command(args):
  global UNDERCUT, OUTLIER_PCT, REPRICE, CHECK_MIN, SPEED, MIN_PROFIT_PCT, WAR_PCT, AH_DROP_PCT, BID_EXTRA_PCT
  global RESCAN_MIN, MM_MODE, PICK_BY, SELL_SPEED_PCT
  load_list()
  cmd = str(args[0]).lower()
  changed = False
  if cmd == "help":
    show_help()
  elif cmd == "list":
    show_list()
  elif cmd == "add":
    if len(args) < 3:
      say("add what, and how many to buy? e.g. \\marketmaker add end_crystal 64")
      return
    item = item_arg(args[1])
    if item is None:
      say("give the item's name")
      return
    vals = []
    for a in args[2:]:
      vals.append(a)
    while len(vals) < 7:
      vals.append("-")
    amount = untok(vals[0])
    if amount is None or amount < 1:
      say("how many to buy? a number like 64")
      return
    per = untok(vals[1])
    if per is None:
      per = 1
    per = to_int(per)
    if per < 1 or per > 64:
      say("per listing must be 1 to 64")
      return
    price = untok(vals[2])
    if price is None:
      price = "auto"
    if price != "auto" and price <= 0:
      say("that price doesn't look right: " + str(vals[2]))
      return
    c = {"item": item, "total": amount, "per_listing": per, "price": price, "min": untok(vals[3]), "max": untok(vals[4]),
         "margin": untok(vals[5]), "maxbuy": untok(vals[6]), "label": None}
    keep = []
    for x in SELL:
      if x["item"] != item:
        keep.append(x)
    keep.append(c)
    set_sell(keep)
    say("added " + describe(c))
    changed = True
  elif cmd == "remove":
    if len(args) < 2:
      say("remove what? an item name, or all")
      return
    if str(args[1]).lower() == "all":
      set_sell([])
      say("trade list cleared")
    else:
      item = item_arg(args[1])
      keep = []
      for x in SELL:
        if x["item"] != item:
          keep.append(x)
      if len(keep) == len(SELL):
        say(str(item) + " isn't on the list")
        return
      set_sell(keep)
      say("removed " + str(item))
    changed = True
  elif cmd == "set":
    if len(args) < 4:
      say("set <item> <amount|per|price|min|max|margin|maxbid|label> <value>")
      return
    item = item_arg(args[1])
    field = str(args[2]).lower()
    fields = {"amount": "total", "total": "total", "per": "per_listing", "price": "price", "min": "min", "max": "max",
             "margin": "margin", "maxbid": "maxbuy", "maxbuy": "maxbuy", "label": "label"}
    if field not in fields:
      say("set what? amount, per, price, min, max, margin, maxbid or label")
      return
    c = cfg_of(item)
    if c is None:
      say(str(item) + " isn't on the list - add it first")
      return
    if field == "label":
      lab = []
      for a in args[3:]:
        lab.append(str(a).lower())
      c["label"] = " ".join(lab)
      save_list()
      say("now " + describe(c))
      changed = True
    else:
      v = untok(args[3])
      if field == "per":
        if v is None or v < 1 or v > 64:
          say("per listing must be 1 to 64")
          return
        v = to_int(v)
      if field == "total" and (v is None or v < 1):
        say("buy amount must be a number like 64")
        return
      if field == "price" and v is None:
        v = "auto"
      c[fields[field]] = v
      save_list()
      say("now " + describe(c))
      changed = True
  elif cmd == "mode" and len(args) >= 2 and str(args[1]).lower() in ["ask", "auto"]:
    MM_MODE = str(args[1]).lower()
    if MM_MODE == "auto":
      say("AUTO: starts a round by itself whenever the spread is good")
    else:
      say("ASK: shows you the spread and waits for your yes / no in chat")
    changed = True
  elif cmd == "pick" and len(args) >= 2 and str(args[1]).lower() in ["profit", "percent"]:
    PICK_BY = str(args[1]).lower()
    say("after every round the best item by " + PICK_BY + " is picked")
    changed = True
  elif cmd == "margin" and len(args) >= 2 and untok(args[1]) is not None:
    MIN_PROFIT_PCT = untok(args[1])
    say("buying needs at least " + num_str(MIN_PROFIT_PCT) + "% profit per item (unless an item has its own margin)")
    changed = True
  elif cmd == "war" and len(args) >= 2 and untok(args[1]) is not None:
    WAR_PCT = untok(args[1])
    say("rough check: your bid ends up " + num_str(WAR_PCT) + "% higher")
    changed = True
  elif cmd == "drop" and len(args) >= 2 and untok(args[1]) is not None:
    AH_DROP_PCT = untok(args[1])
    say("rough check: the auction price falls " + num_str(AH_DROP_PCT) + "% before you've sold")
    changed = True
  elif cmd == "bid" and len(args) >= 2 and untok(args[1]) is not None:
    BID_EXTRA_PCT = untok(args[1])
    say("bids go " + num_str(BID_EXTRA_PCT) + "% above the best order (plus one price step)")
    changed = True
  elif cmd == "rescan" and len(args) >= 2 and untok(args[1]) is not None:
    RESCAN_MIN = untok(args[1])
    say("a spread that isn't worth it gets checked again after " + num_str(RESCAN_MIN) + " min")
    changed = True
  elif cmd == "undercut" and len(args) >= 2:
    UNDERCUT = untok(args[1])
    if UNDERCUT is None:
      UNDERCUT = 0
    say("undercut is now " + fmt_money(UNDERCUT) + " under the cheapest (only used when following is off)")
    changed = True
  elif cmd == "outlier" and len(args) >= 2 and untok(args[1]) is not None:
    OUTLIER_PCT = untok(args[1])
    say("listings more than " + num_str(OUTLIER_PCT) + "% under normal now count as dumping")
    changed = True
  elif cmd == "reprice" and len(args) >= 2:
    REPRICE = str(args[1]).lower() == "on"
    say("re-pricing is now " + str(args[1]).lower())
    changed = True
  elif cmd == "speed" and len(args) >= 2 and untok(args[1]) is not None:
    SPEED = untok(args[1])
    say("listing speed is now " + num_str(SPEED) + " (1 = careful, 2 = fast)")
    changed = True
  elif cmd == "check" and len(args) >= 2 and untok(args[1]) is not None:
    CHECK_MIN = untok(args[1])
    say("auction prices get checked every " + num_str(CHECK_MIN) + " min")
    changed = True
  elif cmd == "stop":
    if other_run_alive():
      System.setProperty(RUN_KEY, "")
      say("stopping")
    else:
      say("it isn't running")
    return
  else:
    say("don't know '" + cmd + "' - \\marketmaker help")
    return
  if changed:
    save_list()
    if other_run_alive():
      System.setProperty(RELOAD_KEY, "1")
      say("(the running script picks this up now)")

def set_sell(lst):
  global SELL
  SELL = lst

def check_reload():
  global last_check
  v = System.getProperty(RELOAD_KEY)
  if v is None or str(v) != "1":
    return
  System.setProperty(RELOAD_KEY, "")
  load_list()
  for k in prices:
    if cfg_of(k) is None or cfg_of(k)["price"] != "auto":
      prices[k] = None
  last_check = -1
  show_list()

wiz = None
wiz_answer = None
chat_hook = None
WIZARD_KEY = "minescript.marketmaker.wizard"

def on_out_chat(event):
  global wiz_answer
  try:
    wiz_answer = str(event.message).strip()
  except Exception:
    wiz_answer = ""

def hook_chat(on):
  global chat_hook
  if on and chat_hook is None:
    chat_hook = add_event_listener("outgoing_chat_intercept", on_out_chat)
  if not on and chat_hook is not None:
    try:
      remove_event_listener(chat_hook)
    except Exception:
      pass
    chat_hook = None

def ask(q):
  hook_chat(True)
  say(">>> " + q)

def start_wizard(fresh):
  global wiz, wiz_answer
  wiz_answer = None
  try:
    hook_chat(True)
  except Exception as e:
    say("can't read your chat answers on this setup (" + short_error(e) + ") - use \\marketmaker add ... instead (\\marketmaker help)")
    wiz = None
    return False
  wiz = {"step": "item", "fresh": fresh}
  if fresh:
    say("let's set up what to trade. Type 'cancel' any time to stop.")
  ask("WHAT ITEM? Type its name (e.g. golden apple, diamond)")
  return True

def end_wizard():
  global wiz, last_check
  wiz = None
  hook_chat(False)
  last_check = -1

def ask_confirm_chat(c, text):
  global wiz, wiz_answer
  wiz_answer = None
  hook_chat(True)
  wiz = {"step": "confirm", "c": c, "fresh": False}
  say(">>> " + text + " Type 'yes' to order, 'no' to skip (checks again later), or 'auto' to order from now on without asking")

def wizard_tick():
  global wiz_answer, SELL, MM_MODE
  if wiz is None:
    return False
  if wiz_answer is None:
    return True
  a = wiz_answer
  wiz_answer = None
  low = a.lower()
  st = wiz["step"]
  if st == "confirm":
    c = wiz["c"]
    if low in ["yes", "y", "ok", "buy", "order"]:
      end_wizard()
      mm_confirmed(c, True)
    elif low == "auto":
      MM_MODE = "auto"
      save_list()
      end_wizard()
      say("AUTO on: starts rounds by itself while the spread is good")
      mm_confirmed(c, True)
    else:
      end_wizard()
      mm_confirmed(c, False)
    return True
  if low == "cancel" or low == "stop":
    end_wizard()
    load_list()
    if len(SELL) == 0:
      shutdown("MM: nothing to trade - stopped. Start again with \\marketmaker")
    else:
      say("ok, keeping your list as it was")
      show_list()
    return True
  if st == "item":
    item = item_arg(low.replace(" ", "_"))
    if item is None:
      ask("type the item's name")
      return True
    lab = None
    wiz["c"] = {"item": item, "total": 64, "per_listing": 1, "price": "auto", "min": None, "max": None, "margin": None,
                "maxbuy": None, "label": lab}
    say("item: " + item + " (shown as '" + label_of(wiz["c"]) + "' in the menus - if that's wrong: \\marketmaker set " + item + " label <name>)")
    wiz["step"] = "amount"
    ask("HOW MANY TO BUY? A number like 64 - it orders this many, sells them all, then does the next order")
    return True
  if st == "amount":
    v = untok(low)
    if v is None or v < 1:
      ask("type a number like 64")
      return True
    wiz["c"]["total"] = v
    wiz["step"] = "per"
    ask("HOW MANY PER AUCTION LISTING? 1 = singles, 64 = full stacks")
    return True
  if st == "per":
    v = untok(low)
    if low == "stack" or low == "stacks":
      v = 64
    if v is None or v < 1 or v > 64:
      ask("type 1 to 64")
      return True
    wiz["c"]["per_listing"] = to_int(v)
    wiz["step"] = "margin"
    ask("MINIMUM PROFIT % to buy (profit per item / its cost)? e.g. 5. Type 'ok' for the default " + num_str(MIN_PROFIT_PCT) + "%")
    return True
  if st == "margin":
    if low in ["ok", "default", "-", "none"]:
      wiz["c"]["margin"] = None
    else:
      v = untok(low)
      if v is None or v < 0:
        ask("type a % like 5, or 'ok' for the default")
        return True
      wiz["c"]["margin"] = v
    return wizard_add()
  if st == "more":
    if low in ["yes", "y", "add", "more"]:
      wiz["step"] = "item"
      ask("WHAT ITEM? Type its name")
      return True
    end_wizard()
    show_list()
    say("starting - it checks the spread first")
    return True
  return True

def wizard_add():
  global SELL
  c = wiz["c"]
  keep = []
  if not wiz["fresh"]:
    for x in SELL:
      if x["item"] != c["item"]:
        keep.append(x)
  else:
    for x in SELL:
      if x["item"] != c["item"] and "added_now" in x:
        keep.append(x)
  c["added_now"] = True
  keep.append(c)
  SELL = keep
  save_list()
  say("added " + describe(c))
  say("selling price: " + describe_auto())
  wiz["step"] = "more"
  ask("ANOTHER ITEM? 'yes' or 'no' (no = start)")
  return True

def describe_auto():
  if FOLLOW_ONLY:
    return "it lists at the SAME price as the cheapest other listing (follow, never lead) and never below what it cost you. Fixed price: \\marketmaker set <item> price 59k"
  return "it lists " + fmt_money(UNDERCUT) + " under the cheapest other listing, never below what it cost you"

def check_wizard_request():
  v = System.getProperty(WIZARD_KEY)
  if v is None or str(v) == "":
    return
  System.setProperty(WIZARD_KEY, "")
  if wiz is None:
    close_all()
    start_wizard(str(v) == "new")

steps = []
set_up = False
last_hp = None
last_heartbeat = 0
status = "starting"

listed = []
ah_free = -1
last_sync = -1
last_check = -1
prices = {}
normals = {}
placed = {}
sold = {}
money_in = {}
said_lore = False

def cfg_of(item_id):
  for c in SELL:
    if c["item"] == item_id:
      return c
  return None

def search_text(c):
  if "search" in c:
    return c["search"]
  return c["item"].replace("_", " ")

def get0(dct, k):
  if k in dct:
    return dct[k]
  return 0

def item_listed(item_id):
  n = 0
  for e in listed:
    if e[0] == item_id:
      n = n + e[2]
  return n

def my_name():
  try:
    return str(mc.player.getName().getString()).lower()
  except Exception:
    return "?"

def listing_price(st):
  for ln in lore_lines(st):
    i = ln.find("$")
    if i >= 0:
      v = parse_money(clip(ln, i, i + 25))
      if v is not None and v > 0:
        return v
  return None

def is_mine(st):
  me = my_name()
  for ln in lore_lines(st):
    if me in ln:
      return True
  return False

def ah_net(p):
  return p * (1.0 - AH_FEE_PCT / 100.0)

def by_value(vals):
  out = []
  for x in vals:
    k = 0
    while k < len(out) and out[k] <= x:
      k = k + 1
    out.insert(k, x)
  return out

def median(vals):
  v = by_value(vals)
  n = len(v)
  if n == 0:
    return None
  if n % 2 == 1:
    return v[to_int((n - 1) / 2)]
  return (v[to_int(n / 2) - 1] + v[to_int(n / 2)]) / 2.0

def ah_open_ok(m):
  return m is not None and slot_named(m, "your items") >= 0 and slot_named(m, "search") >= 0

def is_pane(nm):
  return nm.endswith("glass_pane")

def shown_ok(shown, want):
  if shown is None:
    return False
  return JMath.abs(shown - want) <= display_step(want) + want * 0.005

def log_sale(item_id, count, money):
  global sold, money_in
  sold[item_id] = get0(sold, item_id) + count
  money_in[item_id] = get0(money_in, item_id) + money
  sale_buf_add(item_id, count, money)

def sync_your_items(m):
  global listed, ah_free, last_sync, said_lore
  free = 0
  now = []
  top = container_size(m)
  if top > 45:
    top = 45
  for i in range(top):
    st = slot_stack(m, i)
    if st.isEmpty():
      free = free + 1
      continue
    nm = item_name(st)
    if is_pane(nm):
      if not nm.startswith("red"):
        free = free + 1
      continue
    if cfg_of(nm) is None:
      continue
    if not said_lore:
      said_lore = True
      say("your listing's tooltip: " + " | ".join(lore_lines(st)))
    p = listing_price(st)
    each = 0.0
    if p is not None:
      each = p / st.getCount()
    now.append([nm, each, st.getCount() * 1.0])
  if free > AH_SLOTS:
    free = AH_SLOTS
  left = []
  for e in now:
    left.append(e)
  for e in listed:
    hit = -1
    for k in range(len(left)):
      x = left[k]
      if x[0] == e[0] and x[2] == e[2] and (x[1] <= 0 or e[1] <= 0 or JMath.abs(x[1] - e[1]) <= e[1] * 0.01 + 1):
        hit = k
        break
    if hit >= 0:
      del left[hit]
    else:
      log_sale(e[0], e[2], ah_net(e[1] * e[2]))
  listed = now
  ah_free = free
  last_sync = tick_count
  sale_buf_flush()

def st_recon(d):
  ph = d["phase"]
  c = d["cfg"]
  if ph == 0:
    close_all()
    send_cmd(AH_CMD)
    d["t0"] = tick_count
    d["phase"] = 1
    wait(hdelay(6, 12))
    return False
  if ph == 1:
    m = container_open()
    if ah_open_ok(m):
      d["prev"] = menu_id(m)
      click(m, slot_named(m, "search"), 0, 0)
      d["phase"] = 2
      d["t0"] = tick_count
      wait(hdelay(6, 12))
      return False
    if timed_out(d, 130):
      say("/ah didn't open")
      close_all()
      return True
    return False
  if ph == 2:
    scr = get_screen()
    if is_dialog(scr):
      if handle_warning(scr):
        wait(10)
        return False
      eb = find_editbox(scr)
      if eb is not None and find_btn(scr, "search") is not None:
        eb.setValue(search_text(c))
        d["phase"] = 3
        wait(hdelay(4, 9))
        return False
    if timed_out(d, 100):
      say("the Search Auction box didn't open")
      close_all()
      return True
    return False
  if ph == 3:
    scr = get_screen()
    b = None
    if is_dialog(scr):
      b = find_btn(scr, "search")
    if b is None:
      d["phase"] = 2
      return False
    press_btn(scr, b)
    d["phase"] = 4
    d["t0"] = tick_count
    d["seen"] = -1
    d["page"] = 1
    d["prev_title"] = "@"
    d["prev_sig"] = "@"
    d["others"] = []
    d["mine_min"] = None
    wait(hdelay(6, 10))
    return False
  m = container_open()
  if m is not None and (menu_id(m) != d["prev"] or screen_title() != d["prev_title"] or page_sig(m) != d["prev_sig"]):
    if d["seen"] < 0:
      d["seen"] = tick_count
      return False
    if tick_count - d["seen"] < 8:
      return False
    top = container_size(m)
    if top > 45:
      top = 45
    for i in range(top):
      st = slot_stack(m, i)
      if st.isEmpty() or item_name(st) != c["item"]:
        continue
      p = listing_price(st)
      if p is None:
        continue
      per = p / st.getCount()
      if is_mine(st):
        if d["mine_min"] is None or per < d["mine_min"]:
          d["mine_min"] = per
      else:
        d["others"].append(per)
    nx = slot_named(m, "next page")
    if nx >= 0 and d["page"] < PAGES and len(d["others"]) < READ_LISTINGS:
      d["page"] = d["page"] + 1
      d["prev"] = menu_id(m)
      d["prev_title"] = screen_title()
      d["prev_sig"] = page_sig(m)
      d["seen"] = -1
      d["t0"] = tick_count
      click(m, nx, 0, 0)
      wait(hdelay(3, 6))
      return False
    close_all()
    decide_price(c, d["others"], d["mine_min"])
    wait(hdelay(6, 12))
    return True
  if timed_out(d, 130):
    say("the " + c["item"] + " search showed nothing")
    close_all()
    return True
  return False

def decide_price(c, others, mine_min):
  item = c["item"]
  prices[item] = None
  ask_info[item] = None
  dump_wait[item] = False
  srt = by_value(others)
  lo = c["min"]
  hi = c["max"]
  fl = mm_floor(item)
  if fl is not None and (lo is None or fl > lo):
    lo = fl
  if len(srt) == 0:
    if mine_min is not None:
      prices[item] = mine_min
      ah_say(item, "only", item + ": only your listings are up - keeping " + fmt_money(mine_min))
    else:
      ah_say(item, "none", item + ": nobody else is selling it - not listing (set a fixed price for it in the menu)")
    return
  cheapest = srt[0]
  ten = []
  for k in range(len(srt)):
    if k < READ_LISTINGS:
      ten.append(srt[k])
  mm_price_seen(item, cheapest, cheapest)
  normal = typical_cheapest(item)
  if normal is None:
    three = []
    for k in range(len(srt)):
      if k < 3:
        three.append(srt[k])
    normal = median(three)
  normals[item] = normal
  ask_info[item] = {"cheapest": cheapest, "normal": normal, "n": len(srt),
                    "dump": cheapest < normal * (1.0 - OUTLIER_PCT / 100.0)}
  info = "normal ~" + fmt_money(normal)
  if cheapest < normal * (1.0 - OUTLIER_PCT / 100.0):
    if item not in dump_since or dump_since[item] is None:
      dump_since[item] = tick_count
    left = DUMP_WAIT_MIN * 1200 - (tick_count - dump_since[item])
    if DUMP_WAIT_MIN <= 0 or left > 0:
      ah_say(item, "dump", item + " dumped: " + fmt_money(cheapest) + ", normal " + fmt_money(normal) + " - waiting")
      dump_wait[item] = True
      return
    ah_say(item, "dumpgo", item + ": the low price " + fmt_money(cheapest) + " has held " + num_str(DUMP_WAIT_MIN)
           + " min - it's the price now, following it (never under your cost)")
  else:
    dump_since[item] = None
  p = cheapest - UNDERCUT
  if FOLLOW_ONLY:
    p = cheapest
  elif mine_min is not None and mine_min <= cheapest:
    p = mine_min
  if hi is not None and p > hi:
    p = hi * 1.0
  if lo is not None and p < lo:
    below_cost[item] = True
    ah_say(item, "low", item + ": the cheapest " + fmt_money(p) + " is under what it cost you (" + fmt_money(lo) + ") - not selling at a loss, re-checking every " + num_str(LOW_CHECK_SEC) + "s")
    return
  p = JMath.floor(p)
  prices[item] = p
  below_cost[item] = False
  ah_say(item, "list:" + str(p), item + ": selling at " + fmt_money(p) + " (" + info + ")")
  if REPRICE:
    high = 0
    for e in listed:
      if e[0] == item and e[1] > p + 1:
        high = high + 1
    if high > 0:
      say(item + ": " + str(high) + " of your listings are above " + fmt_money(p) + " - taking them down to re-list")
      steps.insert(1, [st_pull, {"phase": 0, "item": item, "above": p, "below": None}])
  if FOLLOW_ONLY:
    low = 0
    for e in listed:
      if e[0] == item and e[1] < p * (1.0 - RAISE_PCT / 100.0):
        low = low + 1
    if low > 0:
      say(item + ": " + str(low) + " of your listings are under the others' " + fmt_money(p) + " - re-listing them up at theirs")
      steps.insert(1, [st_pull, {"phase": 0, "item": item, "above": None, "below": p * (1.0 - RAISE_PCT / 100.0), "to": p}])

def next_to_list():
  for c in SELL:
    if prices_ok(c) and left_to_list(c) >= c["per_listing"] and biggest_stack(c["item"]) >= c["per_listing"]:
      return c
  return None

def prices_ok(c):
  return c["item"] in prices and prices[c["item"]] is not None

def biggest_stack(item_id):
  b = 0
  for st in stacks_of(item_id):
    if st[0] > b:
      b = st[0]
  return b

def exact_stack(item_id, n):
  for st in stacks_of(item_id):
    if st[0] == n:
      return st[1]
  return -1

def hd(a, b):
  sp = SPEED * SELL_SPEED_PCT / 100.0
  if sp < 0.5:
    sp = 0.5
  lo = to_int(a / sp)
  hi = to_int(b / sp)
  if lo < 2:
    lo = 2
  if hi < lo:
    hi = lo
  return hdelay(lo, hi)

def st_split(d):
  global last_nav
  ph = d["phase"]
  invm = mc.player.inventoryMenu
  if ph == 0:
    close_all()
    src = -1
    big = 0
    for st in stacks_of(d["item"]):
      if st[0] > d["n"] and st[0] > big:
        big = st[0]
        src = st[1]
    if src < 0:
      return True
    empt = []
    for i in range(36):
      if i != FOOD_SLOT - 1 and inv_stack(i).isEmpty():
        empt.append(i)
    k = d["k"]
    if k > len(empt):
      k = len(empt)
    if k > to_int(big / d["n"]):
      k = to_int(big / d["n"])
    if k < 1:
      say("no empty inventory slot to split " + d["item"] + " into - free one up")
      return True
    d["targets"] = []
    for i in range(k):
      d["targets"].append(empt[i])
    d["src"] = src
    d["ti"] = 0
    d["put"] = 0
    try:
      Inv = JavaClass("net.minecraft.client.gui.screens.inventory.InventoryScreen")
      set_screen(Inv(mc.player))
    except Exception:
      pass
    d["phase"] = 1
    wait(hd(5, 9))
    return False
  if ph == 1:
    click(invm, inv_menu_slot(d["src"]), 0, 0)
    d["phase"] = 2
    wait(hd(3, 6))
    return False
  if ph == 2:
    click(invm, inv_menu_slot(d["targets"][d["ti"]]), 1, 0)
    d["put"] = d["put"] + 1
    if d["put"] >= d["n"]:
      d["put"] = 0
      d["ti"] = d["ti"] + 1
      if d["ti"] >= len(d["targets"]):
        d["phase"] = 3
    wait(hd(2, 4))
    return False
  if ph == 3:
    click(invm, inv_menu_slot(d["src"]), 0, 0)
    d["phase"] = 4
    wait(hd(4, 8))
    return False
  try:
    mc.player.closeContainer()
  except Exception:
    pass
  if get_screen() is not None:
    set_screen(None)
  last_nav = None
  wait(hd(8, 14))
  return True

def ready_split(d, item_id, n, k):
  if exact_stack(item_id, n) >= 0:
    d["split_tries"] = 0
    return True
  t = dget(d, "split_tries", 0)
  if t >= 2:
    return True
  d["split_tries"] = t + 1
  steps.insert(0, [st_split, {"phase": 0, "item": item_id, "n": n, "k": k}])
  return False

def listing_retry(d):
  n = dget(d, "ins_tries", 0) + 1
  d["ins_tries"] = n
  close_all()
  if n > 5:
    say("listing failed 5 times in a row - trying again next round")
    return True
  say("the server missed that (lag?) - starting the listing over (" + str(n) + "/5)")
  d["phase"] = 0
  wait(hdelay(8, 14))
  return False

def st_list(d):
  global ah_free
  ph = d["phase"]
  if ph == 0:
    c = next_to_list()
    if c is None:
      return True
    if "done" in d and d["done"] >= PER_PASS:
      return True
    if ah_free == 0 and last_sync >= 0 and tick_count - last_sync < FULL_RECHECK_SEC * 20:
      return True
    k = 1
    if c["per_listing"] == 1:
      k = ah_free
      if k > 16 or k < 1:
        k = 16
    if not ready_split(d, c["item"], c["per_listing"], k):
      return False
    if "done" not in d:
      d["done"] = 0
    close_all()
    send_cmd(AH_CMD)
    d["t0"] = tick_count
    d["phase"] = 1
    wait(hd(6, 12))
    return False
  if ph == 1:
    m = container_open()
    if ah_open_ok(m):
      d["prev"] = menu_id(m)
      click(m, slot_named(m, "your items"), 0, 0)
      d["phase"] = 2
      d["t0"] = tick_count
      wait(hd(6, 12))
      return False
    if timed_out(d, 100):
      if dget(d, "ah_tries", 0) < 3:
        d["ah_tries"] = dget(d, "ah_tries", 0) + 1
        say("/ah didn't open - sending it again (" + str(d["ah_tries"]) + "/3)")
        close_all()
        send_cmd(AH_CMD)
        d["t0"] = tick_count
        wait(hd(6, 12))
        return False
      say("/ah didn't open")
      close_all()
      return True
    return False
  if ph == 2:
    m = container_open()
    if m is None or (menu_id(m) == d["prev"] and "your items" not in screen_title()):
      if timed_out(d, 130):
        say("Your Items didn't open")
        close_all()
        return True
      return False
    if "loaded" not in d:
      d["loaded"] = tick_count
      return False
    if tick_count - d["loaded"] < 5:
      return False
    del d["loaded"]
    sync_your_items(m)
    if check_due():
      close_all()
      return True
    c = next_to_list()
    i = slot_named(m, "list")
    if c is None or i < 0 or ah_free <= 0 or d["done"] >= PER_PASS:
      close_all()
      return True
    d["cfg"] = c
    d["each"] = to_int(prices[c["item"]])
    d["n"] = to_int(c["per_listing"])
    d["prev"] = menu_id(m)
    d["before"] = total_of(c["item"])
    click(m, i, 0, 0)
    d["phase"] = 3
    d["t0"] = tick_count
    wait(hd(6, 12))
    return False
  if ph == 3:
    m = container_open()
    if m is None or "insert" not in screen_title():
      if timed_out(d, 130):
        say("the Insert Item menu didn't open (screen: '" + screen_title() + "')")
        close_all()
        return True
      return False
    mid = -1
    for k in range(container_size(m)):
      if slot_stack(m, k).isEmpty():
        mid = k
        break
    idx = exact_stack(d["cfg"]["item"], d["n"])
    if mid < 0 or idx < 0:
      return listing_retry(d)
    d["mid"] = mid
    d["m"] = m
    if dget(d, "ins_tries", 0) % 2 == 1:
      click(m, inv_to_menu(m, idx), 0, 1)
      d["phase"] = 6
      wait(hd(10, 16))
      return False
    click(m, inv_to_menu(m, idx), 0, 0)
    d["phase"] = 4
    wait(hd(3, 6))
    return False
  if ph == 4:
    click(d["m"], d["mid"], 0, 0)
    d["phase"] = 6
    wait(hd(10, 16))
    return False
  if ph == 6:
    m = container_open()
    if m is None:
      say("Insert Item closed early")
      return True
    st = slot_stack(m, d["mid"])
    if st.isEmpty() or item_name(st) != d["cfg"]["item"] or st.getCount() != d["n"]:
      say("didn't get exactly " + str(d["n"]) + " " + d["cfg"]["item"] + " into the slot - cancelling this listing")
      return listing_retry(d)
    g = confirm_slot(m)
    if g < 0:
      say("no green Confirm in Insert Item")
      close_all()
      return True
    click(m, g, 0, 0)
    d["phase"] = 7
    d["t0"] = tick_count
    wait(hd(6, 12))
    return False
  if ph == 7:
    scr = get_screen()
    if is_dialog(scr):
      if handle_warning(scr):
        wait(10)
        return False
      eb = find_editbox(scr)
      b = find_btn(scr, "continue")
      if eb is not None and b is not None:
        eb.setValue(fmt_price(d["each"] * d["n"]))
        d["phase"] = 8
        wait(hd(4, 9))
        return False
    m = container_open()
    if m is not None and "insert" in screen_title() and tick_count - d["t0"] > 25:
      return listing_retry(d)
    if timed_out(d, 130):
      say("the Type price box didn't open")
      close_all()
      return True
    return False
  if ph == 8:
    scr = get_screen()
    b = None
    if is_dialog(scr):
      b = find_btn(scr, "continue")
    if b is None:
      d["phase"] = 7
      return False
    press_btn(scr, b)
    d["phase"] = 9
    d["t0"] = tick_count
    wait(hd(6, 12))
    return False
  if ph == 9:
    scr = get_screen()
    if is_dialog(scr) and find_btn(scr, "confirm") is not None and find_btn(scr, "continue") is None:
      want = d["each"] * d["n"] * 1.0
      txt = screen_text(scr)
      shown = None
      k = txt.find("$")
      if k >= 0:
        shown = parse_money(clip(txt, k, k + 25))
      if not shown_ok(shown, want):
        say("the confirm screen shows " + str(shown) + ", should be " + fmt_money(want) + " - cancelling")
        cb = find_btn(scr, "cancel")
        if cb is not None:
          press_btn(scr, cb)
        close_all()
        return True
      press_btn(scr, find_btn(scr, "confirm"))
      d["phase"] = 10
      d["t0"] = tick_count
      wait(hd(8, 14))
      return False
    if timed_out(d, 130):
      say("no 'Are you sure' screen after the price")
      close_all()
      return True
    return False
  if d["before"] - total_of(d["cfg"]["item"]) >= d["n"]:
    item = d["cfg"]["item"]
    ah_free = ah_free - 1
    mark_listed()
    if ah_free <= 0:
      global_check_now()
    listed.append([item, d["each"] * 1.0, d["n"] * 1.0])
    placed[item] = get0(placed, item) + d["n"]
    d["done"] = d["done"] + 1
    d["ins_tries"] = 0
    m = container_open()
    if m is not None and slot_named(m, "list") >= 0 and exact_stack(item, d["n"]) >= 0:
      d["prev"] = -1
      d["phase"] = 2
      d["t0"] = tick_count
      wait(hd(6, 10))
      return False
    d["phase"] = 0
    wait(hd(8, 14))
    return False
  if timed_out(d, 80):
    say("the items didn't leave your inventory - not listed")
    close_all()
    return True
  return False

last_list_tick = -1

def mark_listed():
  global last_list_tick
  last_list_tick = tick_count

def check_every():
  for k in dump_wait:
    if dump_wait[k]:
      return DUMP_CHECK_SEC * 20
  if below_cost_any():
    return LOW_CHECK_SEC * 20
  every = CHECK_MIN * 1200
  if last_list_tick >= 0 and tick_count - last_list_tick < 60 * 20:
    every = LISTING_CHECK_SEC * 20
  return every

def below_cost_any():
  for k in below_cost:
    if below_cost[k]:
      return True
  return False

def check_due():
  if last_check < 0:
    return True
  return tick_count - last_check >= check_every()

last_countdown = -1
bar_m = None
below_cost = {}
dump_wait = {}
dump_since = {}

def show_bar(text):
  global bar_m
  try:
    Comp = JavaClass("net.minecraft.network.chat.Component")
    if bar_m is None:
      bar_m = named_methods(mc.gui, "setOverlayMessage", 2)
    for m in bar_m:
      m.invoke(mc.gui, JavaArray((Comp.literal(text), False)))
      return
  except Exception:
    pass

def countdown_tick(next_tick, label):
  global last_countdown
  if next_tick is None:
    return
  if last_countdown >= 0 and tick_count - last_countdown < 100:
    return
  last_countdown = tick_count
  left = to_int((next_tick - tick_count) / 20)
  if left < 0:
    left = 0
  show_bar(label + " next price check in " + str(left) + "s")

def ahs_next_check():
  if last_check < 0:
    return None
  return last_check + check_every()

def global_check_now():
  global last_check
  last_check = -1

def st_pull(d):
  global ah_free
  ph = d["phase"]
  if ph == 0:
    close_all()
    send_cmd(AH_CMD)
    d["t0"] = tick_count
    d["phase"] = 1
    d["pulled"] = 0
    wait(hdelay(6, 12))
    return False
  if ph == 1:
    m = container_open()
    if ah_open_ok(m):
      d["prev"] = menu_id(m)
      click(m, slot_named(m, "your items"), 0, 0)
      d["phase"] = 2
      d["t0"] = tick_count
      wait(hdelay(6, 12))
      return False
    if timed_out(d, 130):
      close_all()
      return True
    return False
  m = container_open()
  if m is None or (menu_id(m) == d["prev"] and "your items" not in screen_title()):
    if timed_out(d, 130):
      close_all()
      return True
    return False
  if "loaded" not in d:
    d["loaded"] = tick_count
    return False
  if tick_count - d["loaded"] < 8:
    return False
  if "synced" not in d:
    d["synced"] = True
    sync_your_items(m)
  top = container_size(m)
  if top > 45:
    top = 45
  for i in range(top):
    st = slot_stack(m, i)
    if st.isEmpty() or item_name(st) != d["item"]:
      continue
    p = listing_price(st)
    if p is None:
      continue
    per = p / st.getCount()
    take = False
    if d["above"] is not None and per > d["above"] + 1:
      take = True
    if dget(d, "below", None) is not None and per < d["below"]:
      take = True
    if take and d["pulled"] < AH_SLOTS:
      cnt = st.getCount() * 1.0
      click(m, i, 0, 0)
      d["pulled"] = d["pulled"] + 1
      for k in range(len(listed)):
        e = listed[k]
        if e[0] == d["item"] and e[2] == cnt and JMath.abs(e[1] - per) <= per * 0.01 + 1:
          del listed[k]
          break
      placed[d["item"]] = get0(placed, d["item"]) - cnt
      ah_free = ah_free + 1
      wait(hdelay(4, 8))
      return False
  if d["pulled"] > 0:
    to = d["above"]
    if to is None:
      to = dget(d, "to", 0)
    say(d["item"] + ": took " + str(d["pulled"]) + " listings down to re-list them at " + fmt_money(to))
  close_all()
  wait(hdelay(6, 10))
  return True

def st_collect(d):
  global orders_info, orders_read_ok, order_slots_free, more_to_collect, expect_orders, last_collect, mm_peek_found
  ph = d["phase"]
  if ph == 0 and "visited" not in d:
    if not expect_orders and not dget(d, "peek", False) and not wants(mm_id()):
      return True
    last_collect = tick_count
  if "visited" not in d:
    d["visited"] = {}
    orders_read_ok = False
    more_to_collect = False
  if ph == 0:
    open_orders(d)
    d["phase"] = 1
    return False
  if ph == 1:
    m = container_open()
    if m is not None and slot_named(m, "your orders") >= 0:
      d["prev"] = menu_id(m)
      click(m, slot_named(m, "your orders"), 0, 0)
      d["phase"] = 2
      d["t0"] = tick_count
      wait(hdelay(5, 10))
      return False
    if timed_out(d, 130):
      say("/orders didn't open")
      close_all()
      return True
    return False
  if ph == 2:
    m = container_open()
    if m is not None and menu_id(m) != d["prev"] and is_your_orders(m):
      if "loaded" not in d:
        d["loaded"] = tick_count
        return False
      if tick_count - d["loaded"] < 5:
        return False
      del d["loaded"]
      infos = []
      free = 0
      top = container_size(m)
      if top > 45:
        top = 45
      for i in range(top):
        s = slot_stack(m, i)
        if s.isEmpty():
          continue
        if hover(s).strip() == "new order":
          free = free + 1
          continue
        if lore_has(s, "requested"):
          o = parse_order(s)
          o["slot"] = i
          o["key"] = order_key(o, i)
          infos.append(o)
      orders_info = infos
      order_slots_free = free
      orders_read_ok = True
      confirm_orders(infos)
      mm_see_orders(infos)
      if dget(d, "peek", False):
        n = 0
        for o in infos:
          if o["id"] == mm_id():
            if not o["completed"]:
              n = n + 1
            elif o["delivered"] > 0 and o["key"] not in done_orders:
              n = n + 1
        mm_peek_found = n
        close_all()
        wait(hdelay(4, 8))
        return True
      if expect_orders:
        mine = 0
        for o in infos:
          if o["id"] == mm_id():
            mine = mine + 1
        if mine == 0:
          return fail_stop("the orders I just made don't show in Your Orders (not enough money? cancelled?)")
        expect_orders = False
      target = None
      for o in infos:
        if o["key"] in done_orders or o["key"] in d["visited"]:
          continue
        if o["delivered"] <= 0 or o["id"] != mm_id():
          continue
        if not wants(o["id"]):
          more_to_collect = True
          continue
        target = o
        break
      if target is None:
        close_all()
        wait(hdelay(4, 8))
        return True
      d["visited"][target["key"]] = True
      d["order"] = target
      d["prev"] = menu_id(m)
      click(m, target["slot"], 0, 0)
      d["phase"] = 3
      d["t0"] = tick_count
      wait(hdelay(5, 10))
      return False
    if m is not None and slot_named(m, "your orders") >= 0 and not is_your_orders(m) and tick_count - d["t0"] > 40 and dget(d, "yo_tries", 0) < 3:
      d["yo_tries"] = dget(d, "yo_tries", 0) + 1
      d["prev"] = menu_id(m)
      click(m, slot_named(m, "your orders"), 0, 0)
      d["t0"] = tick_count
      wait(hdelay(5, 10))
      return False
    if timed_out(d, 100):
      say("Your Orders didn't open")
      close_all()
      return True
    return False
  if ph == 3:
    m = container_open()
    if m is not None and menu_id(m) != d["prev"] and slot_named(m, "collect") >= 0:
      ci = slot_named(m, "collect")
      pending = 0.0
      for ln in lore_lines(slot_stack(m, ci)):
        j = last_find(ln, " x")
        if j >= 0:
          v = parse_money(ln[j + 2:])
          if v is not None:
            pending = pending + v
      o = d["order"]
      readable = lore_has(slot_stack(m, ci), "collect")
      if pending <= 0 and readable:
        if o["completed"]:
          done_orders[o["key"]] = True
        close_all()
        d["phase"] = 0
        wait(hdelay(4, 8))
        return False
      d["prev"] = menu_id(m)
      click(m, ci, 0, 0)
      d["phase"] = 4
      d["t0"] = tick_count
      wait(hdelay(5, 10))
      return False
    if timed_out(d, 100):
      say("the order didn't open")
      close_all()
      return True
    return False
  m = container_open()
  want = d["order"]["id"]
  if m is not None and slot_named(m, "collect") >= 0 and slot_named(m, "cancel") >= 0:
    if tick_count - d["t0"] > 40 and dget(d, "col_tries", 0) < 3:
      d["col_tries"] = dget(d, "col_tries", 0) + 1
      d["prev"] = menu_id(m)
      click(m, slot_named(m, "collect"), 0, 0)
      d["t0"] = tick_count
      wait(hdelay(5, 10))
    elif timed_out(d, 100):
      say("Collect Items didn't open for " + want + " - trying again next round")
      close_all()
      d["phase"] = 0
    return False
  if m is not None and menu_id(m) != d["prev"]:
    if "loaded" not in d:
      d["loaded"] = tick_count
      d["before"] = total_of(want)
      d["last"] = -1
      d["stuck"] = 0
      return False
    if tick_count - d["loaded"] < 5:
      return False
    if wants(want):
      for i in range(container_size(m)):
        s = slot_stack(m, i)
        if not s.isEmpty() and item_name(s) == want:
          if stuck_on(d, i):
            break
          click(m, i, 0, 1)
          wait(hdelay(2, 5))
          return False
    left = 0
    for i in range(container_size(m)):
      s = slot_stack(m, i)
      if not s.isEmpty() and item_name(s) == want:
        left = left + s.getCount()
    if left > 0:
      more_to_collect = True
    elif d["order"]["completed"]:
      done_orders[d["order"]["key"]] = True
    got = total_of(want) - d["before"]
    if got > 0:
      mm_got(got)
      extra = ""
      if left > 0:
        extra = " (" + str(left) + " still waiting)"
      say("collected " + str(got) + " " + want + extra)
    del d["loaded"]
    close_all()
    d["phase"] = 0
    wait(hdelay(4, 8))
    return False
  if timed_out(d, 100):
    say("Collect Items didn't open for " + want)
    close_all()
    d["phase"] = 0
    return False
  return False

session_t0 = -1
bal_start = None
bal_now = None
last_hud = -1
last_bal_read = -1
mm_last_round = ""

hud_lines = None
hud_cb = None
hud_mode = "off"
hud_drawn = False
hud_failed = False
hud_fail_reason = ""
text_searched = False
text_method = None
text_kind = None
text_argc = 0
HUD_BG = -1728053248
HUD_FG = -1
HUD_X = 4
HUD_Y = 4

def money_col(v):
  if v < 0:
    return "§c-$" + fmt_price(-v) + "§r"
  return "§a+$" + fmt_price(v) + "§r"

def clock(t):
  if t < 0:
    t = 0
  s = to_int(t / 20)
  if s >= 3600:
    m = to_int((s % 3600) / 60)
    mm = str(m)
    if m < 10:
      mm = "0" + mm
    return str(to_int(s / 3600)) + "h" + mm + "m"
  sec = str(s % 60)
  if s % 60 < 10:
    sec = "0" + sec
  return str(to_int(s / 60)) + "m" + sec + "s"

def mm_session_live():
  p = mm_session
  r = mm_round
  if r is not None:
    item = r["item"]
    income = get0(money_in, item) - r["income0"]
    p = p + income - r["spent"]
  return p

def mm_hud_lines():
  hours = (tick_count - session_t0) / 72000.0
  if hours < 1.0 / 60.0:
    hours = 1.0 / 60.0
  prof = mm_session_live()
  rate_h = prof / hours
  if rate_h < 0:
    rate_h = 0.0
  rl = ""
  r = mm_round
  if r is None:
    if mm_scan_only:
      rl = "§7scanning the spreads"
    elif mm_between > tick_count:
      rl = ("§e§lNEXT ROUND IN " + str(to_int((mm_between - tick_count) / 20) + 1) + "s §r§7- §a\\yes§7 now, §c\\no§7 stop")
    elif tick_count < mm_next_scan:
      rl = "§7between rounds: next spread read in §f" + clock(mm_next_scan - tick_count)
    else:
      rl = "§7between rounds: reading the spreads"
  else:
    item = r["item"]
    lab = nice_name(item)
    num = str(mm_rounds_done + 1)
    if r["phase"] == "buying":
      rl = ("§7round " + num + " §f" + lab + "§7: §eORDERING §f" + clock(tick_count - r["t0"]) + " §7- bought "
            + str(to_int(r["bought"])) + "/" + str(to_int(r["qty"])))
    else:
      rl = ("§7round " + num + " §f" + lab + "§7: §aSELLING §f" + clock(tick_count - r["sell_t"]) + " §7(ordering took "
            + clock(r["sell_t"] - r["t0"]) + ")")
  ml = None
  rkl = None
  if r is not None:
    item = r["item"]
    each = 0.0
    if r["qty_total"] > 0:
      each = r["spent"] / r["qty_total"]
    nsold = get0(sold, item) - r["sold0"]
    income = get0(money_in, item) - r["income0"]
    ml = ("§7paid §f" + fmt_money(r["spent"]) + " §7for " + str(to_int(r["qty_total"])) + " (§f" + fmt_money(each)
          + "§7 each) §8| §7sold §f" + str(to_int(nsold)) + "/" + str(to_int(r["qty_total"])) + " §7for §a" + fmt_money(income))
    rk = []
    held = r["bought"] - nsold
    info = None
    if item in ask_info:
      info = ask_info[item]
    rr = round_rate(r)
    if rr is not None:
      rk.append("§7selling §f~" + str(to_int(rr)) + "/h")
    if len(rk) > 0:
      rkl = " §8| ".join(rk)
  bl = None
  if bal_start is not None:
    bl = "§7balance before session: §f" + fmt_money(bal_start)
  cl = "§7auction: -"
  nx = ahs_next_check()
  if r is not None:
    st = "§7auction: -"
    if r["item"] in ah_status:
      st = "§7" + prettify(ah_status[r["item"]])
    if nx is not None:
      left = to_int((nx - tick_count) / 20)
      if left < 0:
        left = 0
      st = st + " §8| check in §f" + str(left) + "s"
    cl = st
  if typing_since >= 0:
    rl = "§e(paused while your chat is open) §r" + rl
  lines = ["§d§lMARKET MAKER§r §7" + MM_MODE.upper() + " §8| session " + clock(tick_count - session_t0),
           "§7session profit: " + money_col(prof) + "  §7" + money_col(rate_h) + "§7/h  §8(" + str(mm_rounds_done) + " rounds)",
           rl]
  if ml is not None:
    lines.append(ml)
  if rkl is not None:
    lines.append(rkl)
  if bl is not None:
    lines.append(bl)
  lines.append(cl)
  if mm_last_round != "":
    lines.append("§8last: " + prettify(mm_last_round))
  return lines

def mm_hud_tick():
  global last_hud, bal_start, bal_now, last_bal_read, session_t0
  if session_t0 < 0:
    session_t0 = tick_count
  if last_bal_read < 0 or tick_count - last_bal_read > 200:
    last_bal_read = tick_count
    b = read_balance()
    if b is not None:
      bal_now = b
      if bal_start is None:
        bal_start = b
  if last_hud >= 0 and tick_count - last_hud < 40:
    return
  last_hud = tick_count
  lines = mm_hud_lines()
  if hud_mode == "screen" and hud_failed:
    say("the info panel failed (" + hud_fail_reason + ") - showing it above the hotbar instead")
    set_hud_mode("bar")
  if hud_mode == "screen" and not hud_drawn and tick_count - session_t0 > 100:
    set_hud_mode("bar")
  set_hud_lines(lines)
  if hud_mode == "bar":
    show_bar(" §7|§r ".join([lines[1], lines[2], lines[3]]))

def set_hud_lines(lines):
  global hud_lines
  hud_lines = lines

def set_hud_mode(m):
  global hud_mode
  hud_mode = m

def hud_id(path):
  try:
    Identifier = JavaClass("net.minecraft.resources.Identifier")
    return Identifier.fromNamespaceAndPath("marketmaker", path)
  except Exception:
    RL = JavaClass("net.minecraft.resources.ResourceLocation")
    return RL.fromNamespaceAndPath("marketmaker", path)

def setup_hud():
  global hud_cb, hud_mode
  reasons = []
  hud_cb = ManagedCallback(on_hud)
  try:
    Reg = JavaClass("net.fabricmc.fabric.api.client.rendering.v1.hud.HudElementRegistry")
    HudElement = JavaClass("net.fabricmc.fabric.api.client.rendering.v1.hud.HudElement")
    Reg.addLast(hud_id("hud_" + my_token), HudElement(hud_cb))
    hud_mode = "screen"
    return
  except Exception as e:
    reasons.append("hud registry: " + short_error(e))
  try:
    HRC = JavaClass("net.fabricmc.fabric.api.client.rendering.v1.HudRenderCallback")
    HRC.EVENT.register(HRC(hud_cb))
    hud_mode = "screen"
    return
  except Exception as e:
    reasons.append("hud callback: " + short_error(e))
  hud_mode = "bar"
  say("can't draw the info panel on screen (" + "; ".join(reasons) + ") - showing it above the hotbar instead")

def find_text_method(graphics, font):
  Comp = JavaClass("net.minecraft.network.chat.Component")
  sample = Comp.literal("x")
  best = None
  best_score = -1
  for m in graphics.getClass().getMethods():
    pt = m.getParameterTypes()
    if len(pt) < 5 or len(pt) > 6:
      continue
    if not pt[0].isInstance(font):
      continue
    if str(pt[2].getName()) != "int" or str(pt[3].getName()) != "int" or str(pt[4].getName()) != "int":
      continue
    if len(pt) == 6 and str(pt[5].getName()) != "boolean":
      continue
    kind = None
    if str(pt[1].getName()) == "java.lang.String":
      kind = "str"
    elif pt[1].isInstance(sample):
      kind = "comp"
    if kind is None:
      continue
    if "center" in str(m.getName()).lower():
      continue
    score = 0
    if kind == "str":
      score = score + 4
    if len(pt) == 6:
      score = score + 2
    if score > best_score:
      best_score = score
      best = [m, kind, len(pt)]
  return best

def on_hud(graphics, delta):
  global hud_drawn, hud_failed, hud_fail_reason, text_searched, text_method, text_kind, text_argc
  hud_drawn = True
  if hud_failed or hud_lines is None or menu is not None:
    return
  try:
    font = mc.font
    if not text_searched:
      text_searched = True
      found = find_text_method(graphics, font)
      if found is None:
        hud_failed = True
        hud_fail_reason = "no text method"
        return
      text_method = found[0]
      text_kind = found[1]
      text_argc = found[2]
    lines = hud_lines
    maxw = 0
    for ln in lines:
      wdt = font.width(ln)
      if wdt > maxw:
        maxw = wdt
    x = HUD_X
    y = HUD_Y
    graphics.fill(to_int(x - 3), to_int(y - 3), to_int(x + maxw + 3), to_int(y + len(lines) * 10 + 1), HUD_BG)
    Comp = None
    if text_kind == "comp":
      Comp = JavaClass("net.minecraft.network.chat.Component")
    for ln in lines:
      obj = ln
      if Comp is not None:
        obj = Comp.literal(ln)
      if text_argc == 6:
        text_method.invoke(graphics, JavaArray((font, obj, to_int(x), to_int(y), HUD_FG, True)))
      else:
        text_method.invoke(graphics, JavaArray((font, obj, to_int(x), to_int(y), HUD_FG)))
      y = y + 10
  except Exception as e:
    hud_failed = True
    hud_fail_reason = short_error(e)

SMALL_WORDS = ["of", "the", "and", "on", "in", "with", "a"]
sale_buf = {}
ah_said = {}
ah_status = {}

def title_words(t):
  out = []
  for w in str(t).split(" "):
    if w == "":
      continue
    if len(out) > 0 and w in SMALL_WORDS:
      out.append(w)
    else:
      out.append(clip(w, 0, 1).upper() + clip(w, 1, len(w)))
  return " ".join(out)

def nice_name(item):
  c = cfg_of(item)
  if c is not None:
    return title_words(label_of(c))
  if ITEMS["mm"]["id"] == item:
    return title_words(ITEMS["mm"]["label"])
  return title_words(default_label(item))

def prettify(msg):
  pairs = []
  try:
    for c in SELL:
      pairs.append([c["item"], label_of(c)])
    if ITEMS["mm"]["id"] != "?":
      pairs.append([ITEMS["mm"]["id"], ITEMS["mm"]["label"]])
  except Exception:
    return msg
  done = {}
  while True:
    best = None
    for p in pairs:
      if p[0] in done:
        continue
      if best is None or len(p[0]) > len(best[0]):
        best = p
    if best is None:
      break
    done[best[0]] = True
    nice = title_words(best[1])
    msg = msg.replace(best[0], nice)
    if best[1] != "" and best[1] != nice:
      msg = msg.replace(best[1], nice)
  return msg

def sale_buf_add(item, count, money):
  if item not in sale_buf:
    sale_buf[item] = [0.0, 0.0]
  sale_buf[item][0] = sale_buf[item][0] + count
  sale_buf[item][1] = sale_buf[item][1] + money

def sale_buf_flush():
  global sale_buf
  for item in sale_buf:
    e = sale_buf[item]
    each = ""
    if e[0] > 1:
      each = " (" + fmt_money(e[1] / e[0]) + " each)"
    say("sold " + str(to_int(e[0])) + " " + item + " for " + fmt_money(e[1]) + each)
  sale_buf = {}

def ah_say(item, key, text):
  ah_status[item] = text
  if item in ah_said and ah_said[item] == key:
    return
  ah_said[item] = key
  if mm_round is not None and mm_round["item"] == item:
    say(text)

menu = None
menu_request = None
menu_actions = []
btn_actions = {}
menu_press = None
menu_cb = None
add_widget_m = None
clear_widgets_m = None
trading = True
scan_note = {}
key_was_down = False
menu_fail = ""
PER_STEPS = [1, 4, 8, 16, 32, 64]

def comp(t):
  return JavaClass("net.minecraft.network.chat.Component").literal(t)

def hidden_method(obj, name, nparams):
  cls = obj.getClass()
  while cls is not None:
    for m in cls.getDeclaredMethods():
      if str(m.getName()) == name and len(m.getParameterTypes()) == nparams:
        m.setAccessible(True)
        return m
    cls = cls.getSuperclass()
  return None

def on_btn(b):
  try:
    k = str(System.identityHashCode(b))
    if k in btn_actions:
      menu_actions.append(btn_actions[k])
  except Exception:
    pass

def setup_menu():
  global menu_press, menu_cb
  if menu_press is not None:
    return True
  try:
    menu_cb = ManagedCallback(on_btn)
    OnPress = JavaClass("net.minecraft.client.gui.components.Button$OnPress")
    menu_press = OnPress(menu_cb)
    return True
  except Exception as e:
    say("can't make menu buttons on this version (" + short_error(e) + ") - use the chat commands (\\marketmaker help)")
    return False

menu_bg_cb = None
menu_bg_obj = None
menu_bg_failed = False
menu_bg_add_m = None

def draw_menu_bg(graphics):
  scr = None
  if menu is not None and "scr" in menu:
    scr = menu["scr"]
  if scr is None:
    return
  W = scr.width
  H = scr.height
  graphics.fill(0, 0, W, H, -16777216)
  if MENU_BACKGROUND != "gradient":
    return
  cx = W / 2.0
  cy = H / 2.0
  rings = 10
  step = 4
  for i in range(rings):
    t = (i + 1) * 1.0 / rings
    ra = W * 0.62 * (1.0 - t * 0.92)
    rb = H * 0.72 * (1.0 - t * 0.92)
    g = to_int(MENU_GLOW_GRAY * t * t)
    col = -16777216 + g * 65793
    y = cy - rb
    while y < cy + rb:
      dy = (y + step / 2.0 - cy) / rb
      if dy > -1.0 and dy < 1.0:
        half = ra * JMath.sqrt(1.0 - dy * dy)
        x1 = to_int(cx - half)
        x2 = to_int(cx + half)
        y1 = to_int(y)
        y2 = to_int(y + step)
        if x1 < 0:
          x1 = 0
        if x2 > W:
          x2 = W
        if y1 < 0:
          y1 = 0
        if y2 > H:
          y2 = H
        if x2 > x1 and y2 > y1:
          graphics.fill(x1, y1, x2, y2, col)
      y = y + step

def on_menu_bg(graphics, mx, my, delta):
  global menu_bg_failed
  if menu_bg_failed:
    return
  try:
    draw_menu_bg(graphics)
  except Exception as e:
    menu_bg_failed = True
    say("can't draw the menu background (" + short_error(e) + ")")

def add_menu_bg(scr):
  global menu_bg_cb, menu_bg_obj, menu_bg_add_m
  if MENU_BACKGROUND == "off" or menu_bg_failed:
    return
  try:
    if menu_bg_obj is None:
      menu_bg_cb = ManagedCallback(on_menu_bg)
      menu_bg_obj = JavaClass("net.minecraft.client.gui.components.Renderable")(menu_bg_cb)
    if menu_bg_add_m is None:
      menu_bg_add_m = hidden_method(scr, "addRenderableOnly", 1)
    menu_bg_add_m.invoke(scr, JavaArray((menu_bg_obj,)))
  except Exception as e:
    say("can't set the menu background (" + short_error(e) + ")")

menu_icon_cb = None
menu_icon_obj = None

def argb(r, g, b):
  return -16777216 + r * 65536 + g * 256 + b

def draw_trash(graphics):
  if menu is None or "trash_xy" not in menu:
    return
  x = menu["trash_xy"][0]
  y = menu["trash_xy"][1]
  red = argb(226, 58, 58)
  dark = argb(110, 22, 22)
  graphics.fill(x + 3, y, x + 6, y + 1, red)
  graphics.fill(x, y + 1, x + 9, y + 3, red)
  graphics.fill(x + 1, y + 3, x + 8, y + 11, red)
  graphics.fill(x + 3, y + 4, x + 4, y + 10, dark)
  graphics.fill(x + 5, y + 4, x + 6, y + 10, dark)

def on_menu_icon(graphics, mx, my, delta):
  try:
    draw_trash(graphics)
  except Exception:
    pass

def add_menu_icon(scr, x, y):
  global menu_icon_cb, menu_icon_obj, menu_bg_add_m
  menu["trash_xy"] = [to_int(x), to_int(y)]
  try:
    if menu_icon_obj is None:
      menu_icon_cb = ManagedCallback(on_menu_icon)
      menu_icon_obj = JavaClass("net.minecraft.client.gui.components.Renderable")(menu_icon_cb)
    if menu_bg_add_m is None:
      menu_bg_add_m = hidden_method(scr, "addRenderableOnly", 1)
    menu_bg_add_m.invoke(scr, JavaArray((menu_icon_obj,)))
  except Exception:
    pass

gui_was_hidden = None
hide_field = None
hide_warned = False

def find_hide_field():
  global hide_field
  if hide_field is None:
    cls = mc.options.getClass()
    while cls is not None and hide_field is None:
      for f in cls.getDeclaredFields():
        if str(f.getName()) == "hideGui":
          f.setAccessible(True)
          hide_field = f
          break
      cls = cls.getSuperclass()
  return hide_field

def hide_gui(on):
  global gui_was_hidden, hide_warned
  try:
    f = find_hide_field()
    if f is None:
      raise Exception("no hideGui setting in this version")
    if on:
      if gui_was_hidden is None:
        gui_was_hidden = bool(f.getBoolean(mc.options))
      f.setBoolean(mc.options, True)
    elif gui_was_hidden is not None:
      f.setBoolean(mc.options, gui_was_hidden)
      gui_was_hidden = None
  except Exception as e:
    if not hide_warned:
      hide_warned = True
      say("can't hide the chat behind the menu (" + short_error(e) + ")")

def menu_screen():
  Cls = JavaClass("net.minecraft.client.gui.screens.GenericMessageScreen")
  return Cls(comp(""))

def open_menu(kind):
  global menu, menu_fail
  if not setup_menu():
    return False
  try:
    close_all()
    scr = menu_screen()
    set_screen(scr)
    hide_gui(True)
  except Exception as e:
    menu_fail = short_error(e)
    say("couldn't open the menu (" + menu_fail + ") - use the chat commands (\\marketmaker help)")
    return False
  m = {"kind": kind, "scr": scr, "built": False, "dirty": True, "t0": tick_count, "msg": "", "boxes": {}}
  if menu is not None and menu["kind"] == kind:
    for k in ["sel", "f", "lines", "cfg", "margin", "adv"]:
      if k in menu:
        m[k] = menu[k]
  if kind == "main" and "f" not in m:
    m["sel"] = -1
    m["f"] = blank_fields()
    if len(SELL) > 0:
      m["sel"] = 0
      m["f"] = fields_of(SELL[0])
  if "margin" not in m:
    m["margin"] = num_str(MIN_PROFIT_PCT)
  menu = m
  return True

def blank_fields():
  return {"item": "", "label": None, "amount": "", "per": 1, "margin": "", "price": "auto", "maxbuy": ""}

def fields_of(c):
  f = blank_fields()
  f["item"] = c["item"].replace("_", " ")
  f["label"] = c["label"]
  f["amount"] = num_str(c["total"])
  f["per"] = c["per_listing"]
  if c["margin"] is not None:
    f["margin"] = num_str(c["margin"])
  if c["price"] != "auto":
    f["price"] = fmt_price(c["price"])
  if c["maxbuy"] is not None:
    f["maxbuy"] = fmt_price(c["maxbuy"])
  return f

def add_w(w):
  global add_widget_m
  scr = menu["scr"]
  if add_widget_m is None:
    add_widget_m = hidden_method(scr, "addRenderableWidget", 1)
  add_widget_m.invoke(scr, JavaArray((w,)))
  return w

def w_button(x, y, w, text, action):
  B = JavaClass("net.minecraft.client.gui.components.Button")
  b = B.builder(comp(text), menu_press).bounds(to_int(x), to_int(y), to_int(w), 20).build()
  btn_actions[str(System.identityHashCode(b))] = action
  return add_w(b)

def w_link(x, y, text, action):
  try:
    PTB = JavaClass("net.minecraft.client.gui.components.PlainTextButton")
    c = comp(text)
    b = PTB(to_int(x), to_int(y), to_int(mc.font.width(c)), 10, c, menu_press, mc.font)
    btn_actions[str(System.identityHashCode(b))] = action
    return add_w(b)
  except Exception:
    return w_button(x, y, 200, text, action)

def w_label(x, y, w, text):
  try:
    SW = JavaClass("net.minecraft.client.gui.components.StringWidget")
    s = SW(to_int(x), to_int(y), to_int(w), 20, comp(text), mc.font)
    try:
      s.alignLeft()
    except Exception:
      pass
    return add_w(s)
  except Exception:
    b = w_button(x, y, w, text, "none")
    try:
      b.active = False
    except Exception:
      pass
    return b

def w_box(x, y, w, name, value, hint):
  EB = JavaClass("net.minecraft.client.gui.components.EditBox")
  e = EB(mc.font, to_int(x), to_int(y), to_int(w), 20, comp(name))
  e.setMaxLength(40)
  e.setValue(str(value))
  if hint != "":
    try:
      e.setHint(comp("§8" + hint))
    except Exception:
      pass
  menu["boxes"][name] = e
  return add_w(e)

def read_boxes():
  if menu is None or menu["kind"] != "main":
    return
  b = menu["boxes"]
  f = menu["f"]
  for k in ["item", "amount", "margin", "price", "maxbuy"]:
    if k in b:
      try:
        f[k] = str(b[k].getValue())
      except Exception:
        pass
  if "default_margin" in b:
    try:
      menu["margin"] = str(b["default_margin"].getValue())
    except Exception:
      pass

def build_menu():
  global clear_widgets_m
  scr = menu["scr"]
  if clear_widgets_m is None:
    clear_widgets_m = hidden_method(scr, "clearWidgets", 0)
  clear_widgets_m.invoke(scr, JavaArray(()))
  menu["boxes"] = {}
  reset_btn_actions()
  add_menu_bg(scr)
  if menu["kind"] == "confirm":
    build_confirm(scr)
  else:
    build_main(scr)
  menu["built"] = True
  menu["dirty"] = False

def speed_name():
  if SELL_SPEED_PCT == 100:
    return "§aFAST"
  if SELL_SPEED_PCT == 80:
    return "§eMEDIUM"
  return num_str(SELL_SPEED_PCT) + "%"

def short_line(c):
  t = nice_name(c["item"]) + " - buys " + str(to_int(c["total"]))
  if c["item"] in scan_note:
    t = t + " " + scan_note[c["item"]]
  if len(strip_codes(t)) > 30:
    t = clip(t, 0, 30)
  return t

def build_main(scr):
  W = scr.width
  H = scr.height
  bw = to_int(mc.font.width(comp("How many items to buy e.g 64"))) + 18
  if bw < 125:
    bw = 125
  fw = 75 + bw
  lx = to_int(W / 2) - to_int((200 + 12 + fw) / 2)
  rx = lx + 212
  y = 6
  if H < 250:
    y = 2
  top = y
  run = "§7(not started)"
  if trading:
    run = "§a(running)"
  w_button(lx, y - 1, 44, "§cClose", "close")
  y = y + 22
  w_label(lx, y, 200, "§d§lMARKET MAKER§r " + run)
  y = y + 18
  n = 0
  for i in range(len(SELL)):
    if n >= 5:
      break
    n = n + 1
    c = SELL[i]
    t = short_line(c)
    if menu["sel"] == i:
      t = "§e> " + t
    if is_on(c):
      w_button(lx, y, 20, "§a✔", "tog:" + str(i))
    else:
      w_button(lx, y, 20, "§8✘", "tog:" + str(i))
    w_button(lx + 22, y, 156, t, "sel:" + str(i))
    w_button(lx + 180, y, 20, "§cX", "del:" + str(i))
