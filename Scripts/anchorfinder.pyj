System = JavaClass("java.lang.System")

MIN_CLUSTER = 2
HOTSPOT_SIZE = 5
CLUSTER_GAP = 13.0
CLUSTER_EVERY = 20

GLOW_ALL = True
GLOW_RANGE = 256.0
GLOW_MAX = 120
GLOW_SINGLE_COLOR = (1.0, 1.0, 0.2)
GLOW_GROUP_COLOR = (1.0, 0.55, 0.0)
GLOW_HOTSPOT_COLOR = (1.0, 0.1, 0.35)
GLOW_FILL_OPACITY = 0.3

MARKERS = True
MARKER_COLOR = (1.0, 0.5, 0.0)
MARKER_RANGE = 128.0
MAX_MARKERS = 20

SCREEN_TEXT = True
TEXT_Y_OFFSET = 80
TEXT_COLOR = (1.0, 0.67, 0.0)
TEXT2_COLOR = (1.0, 1.0, 0.33)
TEXT_BACKGROUND = True
TEXT_BG_OPACITY = 0.6

RADAR = True
RADAR_RADIUS = 36
RADAR_DOT = 6
RADAR_COLOR = (1.0, 0.67, 0.0)
ON_TARGET_DEGREES = 8.0

BEAM_HEIGHT = 200
BEAM_DENSITY = 40
BEAM_RADIUS = 0.5
HELIX_PER_TICK = 10
HELIX_RADIUS = 1.4
BEAM_COLOR = (1.0, 0.35, 0.0)
HOTSPOT_BEAM_COLOR = (1.0, 0.1, 0.35)
BEAM_LIFETIME = 30
BEAM_BASE_SIZE = 2.0
SIZE_FULL_DIST = 8.0
MAX_SCALE = 48.0

RING = True
RING_COLOR = (1.0, 0.9, 0.1)
RING_RADIUS = 1.6

POINTER = True
POINTER_COLOR = (0.1, 1.0, 0.2)
POINTER_START = 1.5
POINTER_LENGTH = 6.0
POINTER_Y_OFFSET = -0.6
POINTER_SIZE = 1.6
POINTER_HIDE_WITHIN = 6.0

ANNOUNCE_IN_CHAT = True

CHUNKS_PER_TICK = 8
SECTION_BUDGET = 2

PARTICLE = ParticleTypes.END_ROD
RUN_KEY = "minescript.anchorfinder.token"
BEAT_KEY = "minescript.anchorfinder.beat"

def to_int(v):
  return JDouble.valueOf(str(v)).intValue()

def short_error(e):
  return str(e).split("\n")[0]

def rgb_int(c):
  if c is None:
    return None
  return to_int(to_int(c[0] * 255) * 65536 + to_int(c[1] * 255) * 256 + to_int(c[2] * 255))

def argb_int(c):
  return to_int(rgb_int(c) - 16777216)

def argb_alpha(c, a):
  v = JMath.floor(a * 255.0) * 16777216.0 + rgb_int(c) * 1.0
  if v >= 2147483648.0:
    v = v - 4294967296.0
  return to_int(v)

mc = Minecraft.getInstance()
ANCHOR = Blocks.RESPAWN_ANCHOR
ARROWS = ["↑", "↗", "→", "↘", "↓", "↙", "←", "↖"]
TWO_PI = 6.283185
BEAM_FADE = rgb_int(BEAM_COLOR)
HOTSPOT_FADE = rgb_int(HOTSPOT_BEAM_COLOR)
MARKER_FADE = rgb_int(MARKER_COLOR)
MARKER_LIFE = to_int(6)
RING_FADE = rgb_int(RING_COLOR)
POINTER_FADE = rgb_int(POINTER_COLOR)
TEXT_ARGB = argb_int(TEXT_COLOR)
TEXT2_ARGB = argb_int(TEXT2_COLOR)
TEXT_BG_ARGB = argb_alpha((0.0, 0.0, 0.0), TEXT_BG_OPACITY)
RADAR_ARGB = argb_int(RADAR_COLOR)
RADAR_EDGE_ARGB = argb_alpha((0.0, 0.0, 0.0), 0.85)
ON_TARGET_COS = JMath.cos(JMath.toRadians(ON_TARGET_DEGREES))
GLOW_SINGLE_ARGB = argb_int(GLOW_SINGLE_COLOR)
GLOW_GROUP_ARGB = argb_int(GLOW_GROUP_COLOR)
GLOW_HOTSPOT_ARGB = argb_int(GLOW_HOTSPOT_COLOR)
GLOW_SINGLE_FILL = argb_alpha(GLOW_SINGLE_COLOR, GLOW_FILL_OPACITY)
GLOW_GROUP_FILL = argb_alpha(GLOW_GROUP_COLOR, GLOW_FILL_OPACITY)
GLOW_HOTSPOT_FILL = argb_alpha(GLOW_HOTSPOT_COLOR, GLOW_FILL_OPACITY)
GAP2 = CLUSTER_GAP * CLUSTER_GAP
BEAM_LIFE = to_int(BEAM_LIFETIME)
RING_LIFE = to_int(8)
POINTER_LIFE = to_int(2)

anchor_checks = []
for st in ANCHOR.getStateDefinition().getPossibleStates():
  anchor_checks.append(Predicate.isEqual(st))

known = {}
sweep_found = {}
sweep_chunks = []
sweep_index = 0
sweep_section = 0
clusters = []
anchor_group = {}
glow_active = False
glow_ok = True
glow_fail_reason = ""
glow_reported = False
announced = {}
